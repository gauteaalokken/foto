---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const navLinks = [
  { label: "Flaksjøen Fjellmaraton", href: "/fjellmaraton" },
  { label: "Prints", href: "/prints" },
  { label: "Turer", href: "/turer" },
  { label: "Feed", href: "/feed" },
  { label: "Påmelding 26", href: "/paamelding" },
  { label: "Blog", href: "/blog" },
];
---

<header class="site-header">
  <a href={base || "/"} class="site-title">Gaute Aaløkken</a>

  <nav class="site-nav">
    {navLinks.map((link) => (
      <a href={withBase(link.href)}>{link.label}</a>
    ))}

    <a href="mailto:gauteaalokken@gmail.com" aria-label="Email" class="icon-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </svg>
    </a>

    <a href="https://instagram.com/sommerferiee" target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
    </a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 2rem;
    background: #fdfdfd;
  }

  .site-title {
    font-size: 1.75rem;
    font-weight: 500;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-nav a {
    color: #111;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-nav a:hover {
    opacity: 0.6;
  }

  .icon-link {
    display: flex;
  }
</style>
