---
import { getEntry } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const navLinks = [
  { label: "Flaksjøen Fjellmaraton", href: "/fjellmaraton" },
  { label: "Prints", href: "/prints" },
  { label: "Feed", href: "/feed" },
  { label: "Fotoverktøy", href: "/fotoverktoy/index.html" },
];

// The portfolio page always exists at /portefolje — this only controls
// whether it's linked from the nav, e.g. when showing it to a client.
const portfolioEntry = await getEntry('portfolio', 'index');
if (portfolioEntry?.data.showInNav) {
  navLinks.splice(1, 0, { label: "Portefølje", href: "/portefolje" });
}

// Same pattern for the blog — it always exists at /blogg, this just controls
// whether it's linked from the nav.
const blogSettingsEntry = await getEntry('blogSettings', 'index');
if (blogSettingsEntry?.data.showInNav) {
  navLinks.splice(1, 0, { label: "Blogg", href: "/blogg" });
}
---

<header class="site-header">
  <a href={base || "/"} class="site-title">Gaute Aaløkken</a>

  <nav class="site-nav">
    {navLinks.map((link) => (
      <a
        href={withBase(link.href)}
        class={link.label === "Fotoverktøy" ? "tool-link" : undefined}
      >
        {link.label}
      </a>
    ))}

    <a href="mailto:gauteaalokken@gmail.com" aria-label="Email" class="icon-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </svg>
    </a>

    <a href="https://instagram.com/sommerferiee" target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
    </a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 2rem;
    background: #fdfdfd;
  }

  .site-title {
    font-family: 'Space Mono', monospace;
    font-size: 1.4rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-nav a {
    font-family: 'Space Mono', monospace;
    color: #111;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .site-nav a:hover {
    opacity: 0.6;
  }

  /* Visually separated from the portfolio pages — it's a utility, not part
     of the photography work the rest of the nav links to. */
  .tool-link {
    margin-left: 0.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid #ddd;
    color: #999 !important;
  }

  .icon-link {
    display: flex;
  }

  /* On a short viewport (phone held sideways, small laptop window) the header
     was taking a quarter of the screen — and on the fullscreen homepage, which
     sizes itself to the space left over, that came straight out of the photo.
     Same idea for narrow screens, where the nav wraps onto two or three lines. */
  @media (max-height: 500px), (max-width: 640px) {
    .site-header {
      padding: 0.6rem 1rem;
      gap: 0.5rem;
    }

    .site-title {
      font-size: 1.1rem;
    }

    .site-nav {
      gap: 0.85rem;
    }

    .site-nav a {
      font-size: 0.78rem;
    }
  }
</style>
