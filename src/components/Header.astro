---
import { getEntry } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const navLinks = [
  { label: "Flaksjøen Fjellmaraton", href: "/fjellmaraton" },
  { label: "Prints", href: "/prints" },
  { label: "Feed", href: "/feed" },
  { label: "Fotoverktøy", href: "/fotoverktoy/index.html" },
];

// The portfolio page always exists at /portefolje — this only controls
// whether it's linked from the nav, e.g. when showing it to a client.
const portfolioEntry = await getEntry('portfolio', 'index');
if (portfolioEntry?.data.showInNav) {
  navLinks.splice(1, 0, { label: "Portefølje", href: "/portefolje" });
}

// Same pattern for the blog — it always exists at /blogg, this just controls
// whether it's linked from the nav.
const blogSettingsEntry = await getEntry('blogSettings', 'index');
if (blogSettingsEntry?.data.showInNav) {
  navLinks.splice(1, 0, { label: "Blogg", href: "/blogg" });
}
---

<header class="site-header">
  <a href={base || "/"} class="site-title">Gaute Aaløkken</a>

  <button
    type="button"
    class="nav-toggle"
    aria-label="Meny"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span class="nav-toggle-bars" aria-hidden="true"></span>
  </button>

  <nav class="site-nav" id="site-nav">
    {navLinks.map((link) => (
      <a
        href={withBase(link.href)}
        class={link.label === "Fotoverktøy" ? "tool-link" : undefined}
      >
        {link.label}
      </a>
    ))}

    <div class="nav-icons">
      <a href="mailto:gauteaalokken@gmail.com" aria-label="Email" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3 7l9 6 9-6" />
        </svg>
      </a>

      <a href="https://instagram.com/sommerferiee" target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 2rem;
    background: #fdfdfd;
  }

  .site-title {
    font-family: 'Space Mono', monospace;
    font-size: 1.4rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-nav a {
    font-family: 'Space Mono', monospace;
    color: #111;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .site-nav a:hover {
    opacity: 0.6;
  }

  /* Visually separated from the portfolio pages — it's a utility, not part
     of the photography work the rest of the nav links to. */
  .tool-link {
    margin-left: 0.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid #ddd;
    color: #999 !important;
  }

  .nav-icons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .icon-link {
    display: flex;
  }

  /* Only ever visible on narrow screens — the media query below turns it on
     at the same width where the nav collapses into the panel. */
  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.6rem;
    /* Pulled back out again so the bars still line up with the header's own
       padding — the extra padding is there for the tap target, not the look. */
    margin: -0.6rem -0.6rem -0.6rem 0;
    cursor: pointer;
    color: #111;
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .nav-toggle-bars {
    position: relative;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-bars::before {
    top: -7px;
  }

  .nav-toggle-bars::after {
    top: 7px;
  }

  /* Open: the middle bar disappears and the outer two cross into an X. */
  .site-header.nav-open .nav-toggle-bars {
    background: transparent;
  }

  .site-header.nav-open .nav-toggle-bars::before {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header.nav-open .nav-toggle-bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-toggle-bars,
    .nav-toggle-bars::before,
    .nav-toggle-bars::after {
      transition: none;
    }
  }

  /* On a short viewport (phone held sideways, small laptop window) the header
     was taking a quarter of the screen — and on the fullscreen homepage, which
     sizes itself to the space left over, that came straight out of the photo. */
  @media (max-height: 500px), (max-width: 640px) {
    .site-header {
      padding: 0.6rem 1rem;
      gap: 0.5rem;
    }

    .site-title {
      font-size: 1.1rem;
    }

    .site-nav {
      gap: 0.85rem;
    }

    .site-nav a {
      font-size: 0.78rem;
    }
  }

  /* Narrow screens: the six nav items used to wrap onto three lines and eat
     the top of the page. Behind one button instead — and the open panel is
     positioned rather than in flow, so the header keeps the same height
     whether it's open or shut (the fullscreen homepage measures that height
     to size the photo, and re-measures only on resize). */
  @media (max-width: 640px) {
    .nav-toggle {
      display: block;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 90;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.25rem 1rem 0.75rem;
      background: #fdfdfd;
      border-bottom: 1px solid #eee;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
      /* The fullscreen homepage locks scrolling on <body>, so a panel taller
         than the viewport would have unreachable items — it scrolls itself. */
      max-height: 80vh;
      overflow-y: auto;
    }

    .site-header.nav-open .site-nav {
      display: flex;
    }

    .site-nav a {
      font-size: 0.95rem;
      padding: 0.75rem 0;
    }

    /* The desktop separator is a left border, which reads as nothing in a
       stacked list — same idea, rotated. */
    .tool-link {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
      margin-top: 0.35rem;
      border-top: 1px solid #eee;
    }

    .nav-icons {
      gap: 1.75rem;
      padding-top: 0.85rem;
    }

    .icon-link {
      padding: 0.25rem 0;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = header?.querySelector<HTMLElement>('.site-nav');

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('nav-open'));
    });

    // Tapping a link navigates away on its own, but not for an anchor on the
    // current page — and the panel shouldn't be left hanging open either way.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !header.classList.contains('nav-open')) return;
      setOpen(false);
      toggle.focus();
    });

    // Widening past the breakpoint puts the full nav back on screen by itself;
    // this keeps the button's state from claiming otherwise.
    const wide = window.matchMedia('(min-width: 641px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
