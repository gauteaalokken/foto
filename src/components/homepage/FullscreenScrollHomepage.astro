---
import { withBase } from '../../lib/resolveImage';

interface Project {
  slug: string;
  title: string;
  year: string;
  cover: { src: string; aspectRatio: number } | null;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="scroll-homepage">
  {projects.map((project) => (
    <a class="scroll-section" href={withBase(`/prosjekter/${project.slug}`)}>
      {project.cover && (
        <img class="scroll-cover" src={project.cover.src} alt={project.title} loading="lazy" />
      )}
      <div class="scroll-caption">
        <span class="year">({project.year})</span>
        <span class="title">{project.title}</span>
      </div>
    </a>
  ))}
</div>

{projects.length === 0 && <p class="empty-state">Ingen prosjekter ennå.</p>}

<script>
  // Lands the visitor on a random project instead of always the same one —
  // scrolling up or down from there moves chronologically through the rest,
  // since the sections themselves stay in chronological order.
  const sections = document.querySelectorAll<HTMLElement>('.scroll-section');

  if (sections.length > 1) {
    const randomIndex = Math.floor(Math.random() * sections.length);
    sections[randomIndex]?.scrollIntoView({ behavior: 'instant', block: 'start' });
  }
</script>

<style is:global>
  body.scroll-homepage-active {
    scroll-snap-type: y mandatory;
  }

  .scroll-homepage {
    display: flex;
    flex-direction: column;
  }

  .scroll-section {
    position: relative;
    display: block;
    height: 92vh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: #eee;
  }

  .scroll-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scroll-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  }

  .scroll-caption .year {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #eee;
  }

  .scroll-caption .title {
    font-family: 'Space Mono', monospace;
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
  }

  .empty-state {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
