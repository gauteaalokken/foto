---
import { withBase } from '../../lib/resolveImage';

interface Project {
  slug: string;
  title: string;
  year: string;
  cover: { src: string; aspectRatio: number } | null;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="scroll-homepage" id="scroll-homepage">
  {projects.map((project) => (
    <div class="scroll-section">
      <button type="button" class="nav-arrow nav-prev" aria-label="Forrige prosjekt">&#8249;</button>

      <a class="frame-link" href={withBase(`/prosjekter/${project.slug}`)}>
        <div class="frame">
          {project.cover && (
            <img class="scroll-cover" src={project.cover.src} alt={project.title} loading="lazy" />
          )}
          <div class="scroll-caption">
            <span class="year">({project.year})</span>
            <span class="title">{project.title}</span>
          </div>
        </div>
      </a>

      <button type="button" class="nav-arrow nav-next" aria-label="Neste prosjekt">&#8250;</button>
    </div>
  ))}
</div>

{projects.length === 0 && <p class="empty-state">Ingen prosjekter ennå.</p>}

<script>
  const container = document.getElementById('scroll-homepage');
  const header = document.querySelector<HTMLElement>('.site-header');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.scroll-section'));

  // No vertical scrolling at all: the container is sized to exactly fill
  // whatever space is left below the header, so the page never grows taller
  // than the viewport. Measured (not a fixed guess) since the header's real
  // height varies — e.g. it wraps onto two lines on narrow screens.
  const sizeContainer = () => {
    if (!container || !header) return;
    container.style.height = `${window.innerHeight - header.offsetHeight}px`;
  };

  sizeContainer();
  window.addEventListener('resize', sizeContainer);
  // The header's height can shift by a few pixels once the web font finishes
  // loading (it renders in a fallback font first) — re-measure after that so
  // the container doesn't end up a few pixels too tall, which would make a
  // sliver of vertical scroll possible.
  document.fonts?.ready.then(sizeContainer);

  // A plain mouse wheel only ever reports vertical delta — without this, the
  // sideways gallery would only be scrollable by trackpad/touch swipe, not a
  // normal mouse. Trackpad horizontal swipes already arrive as deltaX and
  // pass through this untouched.
  container?.addEventListener(
    'wheel',
    (event) => {
      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      event.preventDefault();
      container.scrollBy({ left: event.deltaY });
    },
    { passive: false }
  );

  const goTo = (index: number) => {
    const clamped = Math.max(0, Math.min(sections.length - 1, index));
    sections[clamped]?.scrollIntoView({ behavior: 'smooth', inline: 'start' });
  };

  sections.forEach((section, index) => {
    section.querySelector('.nav-prev')?.addEventListener('click', (event) => {
      event.preventDefault();
      goTo(index - 1);
    });
    section.querySelector('.nav-next')?.addEventListener('click', (event) => {
      event.preventDefault();
      goTo(index + 1);
    });
  });

  // Lands the visitor on a random project instead of always the same one —
  // scrolling from there moves chronologically through the rest in either
  // direction, since the sections themselves stay in chronological order.
  if (sections.length > 1) {
    const randomIndex = Math.floor(Math.random() * sections.length);
    sections[randomIndex]?.scrollIntoView({ behavior: 'instant', inline: 'start' });
  }
</script>

<style is:global>
  /* overflow:hidden on body alone isn't enough to fully block scrolling:
     in standards mode the actual scrolling viewport is <html>, not <body>,
     so without this, html could still scroll independently by a few pixels
     even with body locked down. */
  html:has(body.scroll-homepage-active) {
    overflow: hidden;
    height: 100%;
  }

  body.scroll-homepage-active {
    overflow: hidden;
    height: 100%;
  }

  .scroll-homepage {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    /* JS sets the real height (viewport minus header) on load — this is
       just a reasonable fallback before that runs. */
    height: 100vh;
  }

  .scroll-section {
    position: relative;
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #fff;
  }

  .frame-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
    box-sizing: border-box;
    padding: 24px;
  }

  .frame {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Fixed viewport-relative caps (not "fill whatever space is left"): the
       image and its caption are sized and centered as one group, so the
       caption always sits directly under the photo instead of pinned to the
       bottom of the screen with a gap. Leaves enough below max-height for
       the caption to fit without the pair overflowing the frame. */
    max-width: 100%;
  }

  .scroll-cover {
    /* Landscape photos hit max-width first (fill the available width);
       portrait photos hit max-height first (fill the available height) —
       object-fit: contain inside a box shaped like the viewport does this
       automatically without needing to know a photo's orientation upfront. */
    max-width: calc(96vw - 48px);
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .scroll-caption {
    flex: 0 0 auto;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    text-align: left;
  }

  .scroll-caption .year {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
  }

  .scroll-caption .title {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
    color: #111;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    color: #111;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .scroll-section:hover .nav-arrow {
    opacity: 1;
  }

  .nav-prev {
    left: 20px;
  }

  .nav-next {
    right: 20px;
  }

  .empty-state {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
