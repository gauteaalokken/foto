---
import { withBase } from '../../lib/resolveImage';

interface Project {
  slug: string;
  title: string;
  year: string;
  cover: { src: string; srcset: string; aspectRatio: number } | null;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// A clone of the last project before the first, and a clone of the first
// project after the last — lets scrolling run continuously off either end
// into what looks like the next real project, instead of just stopping.
// A tiny script (see below) then silently snaps back to the real slide the
// clone represents once scrolling settles, so the loop is seamless.
const displayProjects = projects.length > 1 ? [projects[projects.length - 1], ...projects, projects[0]] : projects;
---

<div class="scroll-homepage" id="scroll-homepage" data-real-count={projects.length}>
  {displayProjects.map((project) => (
    <div class="scroll-section">
      <button type="button" class="nav-arrow nav-prev" aria-label="Forrige prosjekt">&#8249;</button>

      <div class="frame">
        <a class="image-link" href={withBase(`/prosjekter/${project.slug}`)}>
          {project.cover && (
            <img
              class="scroll-cover"
              src={project.cover.src}
              srcset={project.cover.srcset}
              sizes="calc(100vw - 48px)"
              alt={project.title}
              loading="lazy"
            />
          )}
        </a>
        <div class="scroll-caption">
          <span class="year">({project.year})</span>
          <span class="title">{project.title}</span>
        </div>
      </div>

      <button type="button" class="nav-arrow nav-next" aria-label="Neste prosjekt">&#8250;</button>
    </div>
  ))}
</div>

{projects.length === 0 && <p class="empty-state">Ingen prosjekter ennå.</p>}

<script>
  const container = document.getElementById('scroll-homepage');
  const header = document.querySelector<HTMLElement>('.site-header');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.scroll-section'));
  const realCount = Number(container?.dataset.realCount ?? sections.length);
  const hasClones = sections.length === realCount + 2;

  // Must match the .scroll-section padding and .scroll-caption margin-top
  // in the stylesheet below.
  const SECTION_PADDING = 24;
  const CAPTION_GAP = 16;

  // No vertical scrolling at all: the container is sized to exactly fill
  // whatever space is left below the header, so the page never grows taller
  // than the viewport. Measured (not a fixed guess) since the header's real
  // height varies — e.g. it wraps onto two lines on narrow screens.
  //
  // The photo's height cap is derived from that same measurement rather than
  // a plain `vh` value: `vh` is a fraction of the *whole* viewport, but the
  // space actually available here is the viewport minus the header, minus the
  // caption and padding. On short viewports (a phone held sideways, a small
  // laptop window) a vh-based cap made the photo tall enough to push the
  // caption below the fold — and since vertical scrolling is locked, the
  // project title was simply unreachable.
  const sizeContainer = () => {
    if (!container || !header) return;

    const available = window.innerHeight - header.offsetHeight;
    container.style.height = `${available}px`;

    // Reserve the tallest caption, not the current one: every section shares
    // one cap, and a long title wraps onto more lines than a short one.
    const tallestCaption = Array.from(container.querySelectorAll<HTMLElement>('.scroll-caption')).reduce(
      (max, el) => Math.max(max, el.offsetHeight),
      0
    );

    const photoMax = Math.max(0, available - tallestCaption - CAPTION_GAP - SECTION_PADDING * 2);
    container.style.setProperty('--photo-max-h', `${photoMax}px`);
  };

  sizeContainer();
  window.addEventListener('resize', sizeContainer);
  // The header's height can shift by a few pixels once the web font finishes
  // loading (it renders in a fallback font first) — re-measure after that so
  // the container doesn't end up a few pixels too tall, which would make a
  // sliver of vertical scroll possible.
  document.fonts?.ready.then(sizeContainer);

  // A plain mouse wheel only ever reports vertical delta — without this, the
  // sideways gallery would only be scrollable by trackpad/touch swipe, not a
  // normal mouse. Trackpad horizontal swipes already arrive as deltaX and
  // pass through this untouched.
  container?.addEventListener(
    'wheel',
    (event) => {
      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      event.preventDefault();
      container.scrollBy({ left: event.deltaY });
    },
    { passive: false }
  );

  document.querySelectorAll<HTMLButtonElement>('.nav-prev').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      container?.scrollBy({ left: -(container.clientWidth || 1), behavior: 'smooth' });
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.nav-next').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      container?.scrollBy({ left: container.clientWidth || 1, behavior: 'smooth' });
    });
  });

  // Once scrolling settles on the leading/trailing clone, silently (no
  // animation) jump to the real slide it stands in for — from the visitor's
  // point of view nothing changes, since the clone shows the same project,
  // but it puts them back in the "real" range so the loop can keep going
  // indefinitely in either direction. Debounced rather than reacting to
  // every scroll event, since we only want to act once scrolling has
  // actually stopped.
  if (hasClones && container) {
    let settleTimer: ReturnType<typeof setTimeout>;

    container.addEventListener('scroll', () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => {
        const width = container.clientWidth;
        if (!width) return;
        const index = Math.round(container.scrollLeft / width);

        if (index === 0) {
          container.scrollTo({ left: width * realCount, behavior: 'instant' });
        } else if (index === realCount + 1) {
          container.scrollTo({ left: width * 1, behavior: 'instant' });
        }
      }, 120);
    });
  }

  // Lands the visitor on a random project instead of always the same one —
  // scrolling from there moves chronologically through the rest in either
  // direction, since the sections themselves stay in chronological order.
  if (realCount > 0) {
    const firstRealIndex = hasClones ? 1 : 0;
    const randomIndex = firstRealIndex + Math.floor(Math.random() * realCount);
    const landing = sections[randomIndex];

    landing?.scrollIntoView({ behavior: 'instant', inline: 'start' });

    // Every cover is lazy-loaded, which is right for the 15 nobody is looking
    // at — but the one we just landed on *is* the page, and lazy-loading
    // deprioritizes exactly that image. Which one it'll be isn't known until
    // this runs (it's random), so it's promoted here instead of in the markup.
    const landingImg = landing?.querySelector<HTMLImageElement>('.scroll-cover');
    if (landingImg) {
      landingImg.loading = 'eager';
      landingImg.fetchPriority = 'high';
    }
  }
</script>

<style is:global>
  /* overflow:hidden on body alone isn't enough to fully block scrolling:
     in standards mode the actual scrolling viewport is <html>, not <body>,
     so without this, html could still scroll independently by a few pixels
     even with body locked down. */
  html:has(body.scroll-homepage-active) {
    overflow: hidden;
    height: 100%;
  }

  body.scroll-homepage-active {
    overflow: hidden;
    height: 100%;
  }

  .scroll-homepage {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    /* JS sets the real height (viewport minus header) on load — this is
       just a reasonable fallback before that runs. */
    height: 100vh;
  }

  .scroll-section {
    position: relative;
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 24px;
  }

  .frame {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 100%;
  }

  .image-link {
    display: block;
    cursor: pointer;
  }

  .scroll-cover {
    /* Landscape photos hit max-width first (fill the available width);
       portrait photos hit max-height first (fill the available height) —
       object-fit: contain inside a box shaped like the viewport does this
       automatically without needing to know a photo's orientation upfront.

       --photo-max-h is set in JS from the real space left after the header,
       caption and padding (see sizeContainer). The 78vh fallback only
       applies for the instant before that runs. */
    max-width: calc(100vw - 48px);
    max-height: var(--photo-max-h, 78vh);
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .scroll-caption {
    flex: 0 0 auto;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    text-align: left;
    color: inherit;
  }

  .scroll-caption .year {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
  }

  .scroll-caption .title {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
    color: #111;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    color: #111;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .scroll-section:hover .nav-arrow,
  .nav-arrow:focus-visible {
    opacity: 1;
  }

  /* Touch devices have no hover, so the arrows would otherwise never appear —
     leaving no visible hint that there are more projects to swipe to at all.
     Shown permanently (a little softer) rather than on tap, since the point
     is the affordance itself. */
  @media (hover: none) {
    .nav-arrow {
      opacity: 0.75;
    }
  }

  .nav-prev {
    left: 20px;
  }

  .nav-next {
    right: 20px;
  }

  .empty-state {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
