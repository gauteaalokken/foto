---
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const DEFAULT_DESCRIPTION =
  'Fotografi av Gaute Aaløkken — prosjekter, prints og bilder fra tur og hverdag.';

// A photo rather than a logo, since this is what shows when someone shares a
// link. Pointed straight at R2 because link-preview crawlers fetch it without
// running the page, so it has to be an absolute, always-available URL.
const DEFAULT_OG_IMAGE =
  'https://pub-3870a4bde8aa48ebb61d76487f736f57.r2.dev/projects/DSCF8962.jpg';

const {
  title = 'Gaute Aaløkken',
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gaute Aaløkken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    background: #fafafa;
    color: #111;
  }
</style>
