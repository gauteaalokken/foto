---
// Space Mono, servert fra vårt eget domene i stedet for Google Fonts. Den lå
// før bak en render-blokkerende <link> mot to fremmede verter (fonts.googleapis
// .com for CSS-en, fonts.gstatic.com for selve fila), altså to DNS-oppslag og
// to TLS-håndtrykk før første tekst kunne tegnes. Latin-subsettet dekker æ, ø
// og å, og de to vektene veier drøyt 30 kB til sammen.
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const DEFAULT_DESCRIPTION =
  'Fotografi av Gaute Aaløkken — prosjekter, prints og bilder fra tur og hverdag.';

// A photo rather than a logo, since this is what shows when someone shares a
// link. Pointed straight at R2 because link-preview crawlers fetch it without
// running the page, so it has to be an absolute, always-available URL.
const DEFAULT_OG_IMAGE =
  'https://pub-3870a4bde8aa48ebb61d76487f736f57.r2.dev/projects/DSCF8962.jpg';

const {
  title = 'Gaute Aaløkken',
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

// Link previews are fetched by a crawler that never loads the page, so the
// image has to be an absolute address. Pages that hand us a locally generated
// file pass a site-relative path, which this turns into a full URL; an R2
// address is already absolute and comes back unchanged.
const ogImage = new URL(image, canonical).href;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gaute Aaløkken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Ett sted for farger, skrift og streker. Verdiene lå tidligere skrevet ut
     for hånd i hver enkelt fil — #111 alene 29 ganger — og samme rolle hadde
     drevet fra hverandre underveis: sekundærtekst fantes som #444, #555 og
     #666, streker som #ccc, #ddd, #e5e5e5 og #eee. Rollen er nå navnet, så
     en endring skjer ett sted i stedet for i tretten filer. */
  :root {
    color-scheme: light;

    --font-mono: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;

    /* Tekst */
    --ink: #111;
    --ink-muted: #555;
    --ink-subtle: #888;
    --ink-inverse: #fff;

    /* Flater. Siden, headeren og fullskjermseksjonene på forsiden lå på tre
       nesten like hvitfarger (#fafafa, #fdfdfd, #fff), som ga en så vidt
       synlig skjøt under headeren — de deler denne nå.
       --surface-sunken matcher feltet print-mockupene har innebygd. */
    --surface: #fafafa;
    --surface-raised: #fff;
    --surface-sunken: #f3f3f3;
    --placeholder: #eee;
    --overlay: rgba(0, 0, 0, 0.92);

    /* Streker, fra svakest til sterkest */
    --line-soft: #eee;
    --line: #ddd;
    --line-strong: #ccc;

    /* Status */
    --success: #1a7a1a;
    --danger: #b00020;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--surface);
    color: var(--ink);
  }
</style>
