---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Fant ikke siden — Gaute Aaløkken" description="Siden finnes ikke.">
  <div class="not-found">
    <h1>404</h1>
    <p>Denne siden finnes ikke.</p>
    <a href={base || '/'}>&larr; Tilbake til forsiden</a>
  </div>
</Layout>

<style>
  .not-found {
    max-width: 600px;
    margin: 120px auto;
    padding: 0 20px;
    text-align: center;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 500;
    margin: 0 0 1rem;
  }

  p {
    color: var(--ink-muted);
    margin: 0 0 2rem;
  }

  a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }

  a:hover {
    opacity: 0.6;
  }
</style>
