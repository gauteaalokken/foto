---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { mapWithConcurrency } from '../../lib/concurrency';
import { resolveImage, withBase } from '../../lib/resolveImage';

const settings = await getEntry('blogSettings', 'index');
const pageTitle = settings?.data.title || 'Blogg';
const pageIntro = settings?.data.intro || null;

const entries = await getCollection('blog');
entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const COVER_WIDTH = 700;

const firstImageOf = (blocks: (typeof entries)[number]['data']['blocks']) => {
  for (const block of blocks) {
    if (block.type === 'image') return block.image;
    if (block.type === 'image_pair' || block.type === 'image_grid') return block.images[0];
  }
  return null;
};

const posts = await mapWithConcurrency(entries, 3, async (entry) => {
  const { title, date, blocks } = entry.data;
  const coverSrc = firstImageOf(blocks);
  const cover = coverSrc ? await resolveImage(coverSrc, COVER_WIDTH, 80) : null;

  return { slug: entry.id, title, date, cover };
});
---

<Layout title={`${pageTitle} — Gaute Aaløkken`}>
  <header class="page-header">
    <h1>{pageTitle}</h1>
    {pageIntro && <p class="intro">{pageIntro}</p>}
  </header>

  <div class="posts-grid">
    {posts.map((post) => (
      <a class="post-card" href={withBase(`/blogg/${post.slug}`)}>
        <div class="cover-wrap">
          {post.cover && <img class="cover" src={post.cover} alt={post.title} loading="lazy" />}
        </div>
        <div class="caption">
          <span class="date">
            {new Date(post.date).toLocaleDateString('no-NO', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <span class="title">{post.title}</span>
        </div>
      </a>
    ))}
  </div>

  {posts.length === 0 && <p class="empty-state">Ingen blogginnlegg ennå.</p>}
</Layout>

<style>
  .page-header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px 0;
  }

  .page-header h1 {
    font-family: 'Space Mono', monospace;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    margin: 0;
  }

  .intro {
    max-width: 60ch;
    margin: 1rem 0 0;
    color: #444;
    line-height: 1.6;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px 32px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px 80px;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .cover-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #eee;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .post-card:hover .cover {
    transform: scale(1.02);
  }

  .caption {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .date {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: #888;
  }

  .title {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .empty-state {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
