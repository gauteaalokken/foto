---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { mapWithConcurrency } from '../../lib/concurrency';
import { isRemote, resolveImage, withBase } from '../../lib/resolveImage';

const feed = await getEntry('feed', 'index');
const photos = feed?.data.photos ?? [];

const THUMB_WIDTH = 500;
const INITIAL_BATCH = 60;
const BATCH_SIZE = 40;
const GAP = 4;

// Each photo's true aspect ratio is measured in the browser once its thumbnail
// loads (see bindImage in the script below), not here at build time. Fetching
// every original photo a second time just to measure it doesn't scale past a
// few dozen photos — at 900+ it roughly doubled build-time R2 traffic.
//
// resolveImage (not Astro's own getImage()) does the actual resizing, since it
// skips photos already resized in a previous build instead of redoing all of
// them every time — see src/lib/resolveImage.ts. The lightbox links straight
// to the original R2 file for full quality — no extra resize/fetch needed.
const optimized = await mapWithConcurrency(photos, 4, async (photo) => ({
  src: await resolveImage(photo, THUMB_WIDTH, 60),
  full: isRemote(photo) ? photo : withBase(photo),
}));

const initialPhotos = optimized.slice(0, INITIAL_BATCH);
const remainingPhotos = optimized.slice(INITIAL_BATCH);
---

<Layout
  title="Feed — Gaute Aaløkken"
  description="Et løpende arkiv med bilder fra tur, reise og hverdag."
  image={optimized[0]?.full}
>
  <div class="feed-wrap">
    <div class="grid" id="feed-grid">
      {initialPhotos.map((photo, i) => (
        <div class="cell" data-ratio="1">
          <button type="button" class="photo-button" data-index={i} aria-label="View photo full screen">
            <img class="photo" src={photo.src} alt="" loading="lazy" decoding="async" />
          </button>
        </div>
      ))}
    </div>
  </div>

  {photos.length === 0 && <p class="empty">No photos in the feed yet.</p>}

  <div id="feed-sentinel"></div>

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">&times;</button>
    <button type="button" id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <img id="lightbox-img" class="lightbox-img" alt="" />
    <button type="button" id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>

  <script type="application/json" id="feed-remaining" set:html={JSON.stringify(remainingPhotos)} />
  <script type="application/json" id="feed-full" set:html={JSON.stringify(optimized.map((p) => p.full))} />

  <script define:vars={{ batchSize: BATCH_SIZE, gap: GAP, initialCount: initialPhotos.length }}>
    const grid = document.getElementById('feed-grid');
    const sentinel = document.getElementById('feed-sentinel');
    const dataEl = document.getElementById('feed-remaining');
    const remaining = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    let cursor = 0;

    // Photo size stays roughly constant (targeting this width); the column
    // count is just whatever fits at that size, so photos get fewer per row
    // as the window narrows instead of shrinking to keep the same count.
    const TARGET_CELL_WIDTH = 160;

    const getTargetRowHeight = (containerWidth) => {
      const columns = Math.max(1, Math.round((containerWidth + gap) / (TARGET_CELL_WIDTH + gap)));
      const cellWidth = (containerWidth - gap * (columns - 1)) / columns;
      return cellWidth * (4 / 3);
    };

    const ratioOf = (cell) => parseFloat(cell.dataset.ratio) || 1;

    const layout = () => {
      const cells = grid ? Array.from(grid.children) : [];
      if (!grid || cells.length === 0) return;

      const containerWidth = grid.clientWidth;
      if (containerWidth <= 0) return;

      const targetHeight = getTargetRowHeight(containerWidth);
      const maxHeight = targetHeight * 1.8;

      const rows = [];
      let row = [];
      let rowRatioSum = 0;

      for (const cell of cells) {
        row.push(cell);
        rowRatioSum += ratioOf(cell);

        const widthAtTarget = rowRatioSum * targetHeight + gap * (row.length - 1);
        if (widthAtTarget >= containerWidth) {
          rows.push(row);
          row = [];
          rowRatioSum = 0;
        }
      }

      if (row.length) rows.push(row);

      // The height a row would need to span the full width at its photos' own
      // aspect ratios.
      const naturalHeight = (r) =>
        (containerWidth - gap * (r.length - 1)) / r.reduce((sum, cell) => sum + ratioOf(cell), 0);

      // A leftover final row of one or two photos can't span the width without
      // growing absurdly tall, so it gets capped — stranding it at a fraction of
      // the width with photos noticeably larger than the rows above. Folding it
      // into the previous row costs that row a little height and fills the width
      // instead. While batches are still streaming in the next one simply
      // re-splits it, since layout() rebuilds the rows from scratch each time.
      while (rows.length > 1 && naturalHeight(rows[rows.length - 1]) > maxHeight) {
        const stranded = rows.pop();
        rows[rows.length - 1].push(...stranded);
      }

      for (const currentRow of rows) {
        const natural = naturalHeight(currentRow);
        const height = Math.min(natural, maxHeight);
        const isCapped = height < natural;

        let usedWidth = 0;

        currentRow.forEach((cell, i) => {
          const isLastInRow = i === currentRow.length - 1;
          // The last cell absorbs the rounding remainder so the row lands
          // exactly on the container's right edge.
          const width =
            !isCapped && isLastInRow ? containerWidth - usedWidth : Math.round(ratioOf(cell) * height);

          cell.style.width = `${width}px`;
          cell.style.height = `${height}px`;
          usedWidth += width + gap;
        });
      }
    };

    // setTimeout, not requestAnimationFrame: rAF callbacks are paused
    // indefinitely while the tab is backgrounded/hidden, so a flag reset only
    // inside that callback can get stuck true forever, silently stopping all
    // future layout recalculation. setTimeout is only ever delayed in that
    // situation, never paused forever, so this always eventually runs while
    // still coalescing bursts of image-load events (e.g. many photos
    // finishing at once) into a single layout() call.
    let layoutScheduled = false;
    const scheduleLayout = () => {
      if (layoutScheduled) return;
      layoutScheduled = true;
      setTimeout(() => {
        layoutScheduled = false;
        layout();
      }, 50);
    };

    // Measures each photo's real shape once its thumbnail has actually loaded,
    // instead of fetching the original again at build time just to find out.
    const bindImage = (img, cell) => {
      const applyRatio = () => {
        if (!img.naturalWidth || !img.naturalHeight) return;
        cell.dataset.ratio = String(img.naturalWidth / img.naturalHeight);
        scheduleLayout();
      };

      if (img.complete) applyRatio();
      else img.addEventListener('load', applyRatio, { once: true });
    };

    const addCell = (photo, index) => {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.dataset.ratio = '1';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'photo-button';
      button.dataset.index = String(index);
      button.setAttribute('aria-label', 'View photo full screen');

      const img = document.createElement('img');
      img.className = 'photo';
      img.src = photo.src;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';

      button.appendChild(img);
      cell.appendChild(button);
      grid?.appendChild(cell);
      bindImage(img, cell);
    };

    const loadMore = () => {
      const next = remaining.slice(cursor, cursor + batchSize);

      if (next.length === 0) {
        sentinelObserver?.disconnect();
        clearInterval(sentinelPoll);
        sentinel?.remove();
        return;
      }

      next.forEach((photo, i) => addCell(photo, initialCount + cursor + i));

      cursor += batchSize;
      layout();
    };

    // A ResizeObserver alongside the resize listener, as on the project pages:
    // layout() writes explicit pixel widths onto every cell, so a width change
    // neither trigger hears about leaves the rows ragged. This page mostly got
    // away with only the resize event because each lazily-loaded photo re-runs
    // layout() and papers over a missed one.
    //
    // Only width is relevant: layout() and every appended batch change the
    // grid's height, so reacting to height would loop.
    let lastWidth = grid ? grid.clientWidth : 0;
    let resizeTimer;

    const relayout = () => {
      if (!grid || grid.clientWidth === lastWidth) return;
      lastWidth = grid.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 150);
    };

    if (grid) new ResizeObserver(relayout).observe(grid);
    window.addEventListener('resize', relayout);

    grid?.querySelectorAll('.cell').forEach((cell) => {
      const img = cell.querySelector('.photo');
      if (img) bindImage(img, cell);
    });

    layout();

    // IntersectionObserver instead of manually checking the sentinel's
    // position on scroll/resize events: it's driven directly by the browser's
    // own compositor rather than depending on scroll events actually firing
    // and being handled in time, so it can't silently stop working the way
    // scroll-position polling could.
    //
    // Belt-and-suspenders: also poll on a plain timer, independent of scroll,
    // resize, or intersection events entirely. Some real-world reports of the
    // feed getting stuck loading — even after moving to IntersectionObserver —
    // could not be reproduced or root-caused in testing, so this backstop
    // guarantees loading resumes within a second regardless of why any
    // event-driven path might not be firing for a given browser/session.
    let sentinelObserver;
    let sentinelPoll;
    if (sentinel && remaining.length > 0) {
      sentinelObserver = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) loadMore();
        },
        { rootMargin: '600px' }
      );
      sentinelObserver.observe(sentinel);

      sentinelPoll = setInterval(() => {
        if (!sentinel) return;
        if (sentinel.getBoundingClientRect().top < window.innerHeight + 600) loadMore();
      }, 700);
    } else {
      sentinel?.remove();
    }

    const fullDataEl = document.getElementById('feed-full');
    const allPhotoSrcs = fullDataEl ? JSON.parse(fullDataEl.textContent || '[]') : [];

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    let currentIndex = -1;

    const show = (index) => {
      currentIndex = (index + allPhotoSrcs.length) % allPhotoSrcs.length;
      if (lightboxImg) lightboxImg.src = allPhotoSrcs[currentIndex];
    };

    const openLightbox = (index) => {
      show(index);
      if (lightbox) lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (lightbox) lightbox.hidden = true;
      document.body.style.overflow = '';
    };

    grid?.addEventListener('click', (event) => {
      const button = event.target.closest('.photo-button');
      if (!button) return;
      openLightbox(Number(button.dataset.index));
    });

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => show(currentIndex - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => show(currentIndex + 1));

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox || lightbox.hidden) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') show(currentIndex - 1);
      if (event.key === 'ArrowRight') show(currentIndex + 1);
    });
  </script>
</Layout>

<style is:global>
  .feed-wrap {
    margin: 0 auto;
    padding: 20px;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .cell {
    width: 200px;
    aspect-ratio: 1;
    overflow: hidden;
    background: #eee;
  }

  .photo-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 40px 20px;
  }

  #feed-sentinel {
    height: 1px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem 1rem;
  }

  .lightbox-close {
    top: 1rem;
    right: 1.5rem;
  }

  .lightbox-prev {
    left: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>
