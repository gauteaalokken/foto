---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { mapWithConcurrency } from '../../lib/concurrency';
import { getImageAspectRatio } from '../../lib/imageAspectRatio';

const feed = await getEntry('feed', 'index');
const photos = feed?.data.photos ?? [];

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const isRemote = (path: string) => /^https?:\/\//.test(path);

const THUMB_WIDTH = 500;
const INITIAL_BATCH = 60;
const BATCH_SIZE = 40;
const GAP = 9;

const optimized = await mapWithConcurrency(photos, 4, async (photo) => {
  if (!isRemote(photo)) {
    return { src: withBase(photo), ratio: 3 / 4 };
  }

  const [img, ratio] = await Promise.all([
    getImage({
      src: photo,
      inferSize: true,
      width: THUMB_WIDTH,
      quality: 60,
      format: 'webp',
    }),
    getImageAspectRatio(photo).catch(() => 3 / 4),
  ]);

  return { src: img.src, ratio };
});

const initialPhotos = optimized.slice(0, INITIAL_BATCH);
const remainingPhotos = optimized.slice(INITIAL_BATCH);
---

<Layout title="Feed — Gaute Aaløkken">
  <div class="feed-wrap">
    <div class="grid" id="feed-grid">
      {initialPhotos.map((photo) => (
        <div class="cell" data-ratio={photo.ratio} style={`aspect-ratio: ${photo.ratio}`}>
          <img class="photo" src={photo.src} alt="" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>

  {photos.length === 0 && <p class="empty">No photos in the feed yet.</p>}

  <div id="feed-sentinel"></div>

  <script type="application/json" id="feed-remaining" set:html={JSON.stringify(remainingPhotos)} />

  <script define:vars={{ batchSize: BATCH_SIZE, gap: GAP }}>
    const grid = document.getElementById('feed-grid');
    const sentinel = document.getElementById('feed-sentinel');
    const dataEl = document.getElementById('feed-remaining');
    const remaining = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    let cursor = 0;

    const getTargetRowHeight = (containerWidth) => {
      let columns;
      if (containerWidth >= 1728) columns = 23;
      else if (containerWidth >= 1440) columns = 15;
      else if (containerWidth >= 1200) columns = 10;
      else if (containerWidth >= 768) columns = 7;
      else if (containerWidth >= 480) columns = 5;
      else columns = 4;

      const cellWidth = (containerWidth - gap * (columns - 1)) / columns;
      return cellWidth * (4 / 3);
    };

    const layout = () => {
      const cells = grid ? Array.from(grid.children) : [];
      if (!grid || cells.length === 0) return;

      const containerWidth = grid.clientWidth;
      if (containerWidth <= 0) return;

      const targetHeight = getTargetRowHeight(containerWidth);
      const maxHeight = targetHeight * 1.8;

      let row = [];
      let rowRatioSum = 0;

      const flushRow = (isTrailing) => {
        if (row.length === 0) return;

        const height = isTrailing
          ? targetHeight
          : Math.min((containerWidth - gap * (row.length - 1)) / rowRatioSum, maxHeight);

        let usedWidth = 0;

        row.forEach((cell, i) => {
          const ratio = parseFloat(cell.dataset.ratio) || 1;
          const isLastInRow = i === row.length - 1;
          const width =
            !isTrailing && isLastInRow ? containerWidth - usedWidth : Math.round(ratio * height);

          cell.style.width = `${width}px`;
          cell.style.height = `${height}px`;
          usedWidth += width + gap;
        });

        row = [];
        rowRatioSum = 0;
      };

      for (const cell of cells) {
        const ratio = parseFloat(cell.dataset.ratio) || 1;
        row.push(cell);
        rowRatioSum += ratio;

        const widthAtTarget = rowRatioSum * targetHeight + gap * (row.length - 1);
        if (widthAtTarget >= containerWidth) flushRow(false);
      }

      flushRow(true);
    };

    const addCell = (photo) => {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.dataset.ratio = String(photo.ratio);
      cell.style.aspectRatio = String(photo.ratio);

      const img = document.createElement('img');
      img.className = 'photo';
      img.src = photo.src;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';

      cell.appendChild(img);
      grid?.appendChild(cell);
    };

    const loadMore = () => {
      const next = remaining.slice(cursor, cursor + batchSize);

      if (next.length === 0) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        sentinel?.remove();
        return;
      }

      for (const photo of next) addCell(photo);

      cursor += batchSize;
      layout();
    };

    let ticking = false;

    const checkScroll = () => {
      ticking = false;

      if (!sentinel) return;

      const nearViewport = sentinel.getBoundingClientRect().top < window.innerHeight + 600;

      if (nearViewport) loadMore();
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(checkScroll);
    };

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 150);
    });

    layout();

    if (sentinel && remaining.length > 0) {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      checkScroll();
    } else {
      sentinel?.remove();
    }
  </script>
</Layout>

<style is:global>
  .feed-wrap {
    max-width: 1800px;
    margin: 0 auto;
    padding: 20px;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .cell {
    width: 200px;
    overflow: hidden;
    background: #eee;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 40px 20px;
  }

  #feed-sentinel {
    height: 1px;
  }
</style>
