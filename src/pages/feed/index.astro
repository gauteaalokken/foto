---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { mapWithConcurrency } from '../../lib/concurrency';

const feed = await getEntry('feed', 'index');
const photos = feed?.data.photos ?? [];

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const isRemote = (path: string) => /^https?:\/\//.test(path);

const THUMB_WIDTH = 500;
const INITIAL_BATCH = 60;
const BATCH_SIZE = 40;

const optimized = await mapWithConcurrency(photos, 4, async (photo) => {
  if (!isRemote(photo)) {
    return { src: withBase(photo) };
  }

  const img = await getImage({
    src: photo,
    inferSize: true,
    width: THUMB_WIDTH,
    quality: 60,
    format: 'webp',
  });

  return { src: img.src };
});

const initialPhotos = optimized.slice(0, INITIAL_BATCH);
const remainingPhotos = optimized.slice(INITIAL_BATCH);
---

<Layout title="Feed — Gaute Aaløkken">
  <div class="grid" id="feed-grid">
    {initialPhotos.map((photo) => (
      <div class="cell">
        <img class="photo" src={photo.src} alt="" loading="lazy" decoding="async" />
      </div>
    ))}
  </div>

  {photos.length === 0 && <p class="empty">No photos in the feed yet.</p>}

  <div id="feed-sentinel"></div>

  <script type="application/json" id="feed-remaining" set:html={JSON.stringify(remainingPhotos)} />

  <script define:vars={{ batchSize: BATCH_SIZE }}>
    const grid = document.getElementById('feed-grid');
    const sentinel = document.getElementById('feed-sentinel');
    const dataEl = document.getElementById('feed-remaining');
    const remaining = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    let cursor = 0;

    const loadMore = () => {
      const next = remaining.slice(cursor, cursor + batchSize);

      if (next.length === 0) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        sentinel?.remove();
        return;
      }

      for (const photo of next) {
        const cell = document.createElement('div');
        cell.className = 'cell';

        const img = document.createElement('img');
        img.className = 'photo';
        img.src = photo.src;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';

        cell.appendChild(img);
        grid?.appendChild(cell);
      }

      cursor += batchSize;
    };

    let ticking = false;

    const checkScroll = () => {
      ticking = false;

      if (!sentinel) return;

      const nearViewport = sentinel.getBoundingClientRect().top < window.innerHeight + 600;

      if (nearViewport) loadMore();
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(checkScroll);
    };

    if (sentinel && remaining.length > 0) {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      checkScroll();
    } else {
      sentinel?.remove();
    }
  </script>
</Layout>

<style is:global>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    max-width: 1800px;
    margin: 0 auto;
    padding: 20px;
  }

  @media (min-width: 480px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(8, 1fr);
    }
  }

  @media (min-width: 1600px) {
    .grid {
      grid-template-columns: repeat(10, 1fr);
    }
  }

  .cell {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #eee;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 40px 20px;
  }

  #feed-sentinel {
    height: 1px;
  }
</style>
