---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { mapWithConcurrency } from '../../lib/concurrency';
import { getImageAspectRatio } from '../../lib/imageAspectRatio';

const feed = await getEntry('feed', 'index');
const photos = feed?.data.photos ?? [];

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const isRemote = (path: string) => /^https?:\/\//.test(path);

const THUMB_WIDTH = 500;
const INITIAL_BATCH = 60;
const BATCH_SIZE = 40;
const GAP = 9;

const optimized = await mapWithConcurrency(photos, 4, async (photo) => {
  if (!isRemote(photo)) {
    return { src: withBase(photo), ratio: 3 / 4 };
  }

  const [img, ratio] = await Promise.all([
    getImage({
      src: photo,
      inferSize: true,
      width: THUMB_WIDTH,
      quality: 60,
      format: 'webp',
    }),
    getImageAspectRatio(photo).catch(() => 3 / 4),
  ]);

  return { src: img.src, ratio };
});

const initialPhotos = optimized.slice(0, INITIAL_BATCH);
const remainingPhotos = optimized.slice(INITIAL_BATCH);
---

<Layout title="Feed — Gaute Aaløkken">
  <div class="feed-wrap">
    <div class="grid" id="feed-grid">
      {initialPhotos.map((photo, i) => (
        <div class="cell" data-ratio={photo.ratio} style={`aspect-ratio: ${photo.ratio}`}>
          <button type="button" class="photo-button" data-index={i} aria-label="View photo full screen">
            <img class="photo" src={photo.src} alt="" loading="lazy" decoding="async" />
          </button>
        </div>
      ))}
    </div>
  </div>

  {photos.length === 0 && <p class="empty">No photos in the feed yet.</p>}

  <div id="feed-sentinel"></div>

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">&times;</button>
    <button type="button" id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <img id="lightbox-img" class="lightbox-img" alt="" />
    <button type="button" id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>

  <script type="application/json" id="feed-remaining" set:html={JSON.stringify(remainingPhotos)} />

  <script define:vars={{ batchSize: BATCH_SIZE, gap: GAP, initialCount: initialPhotos.length }}>
    const grid = document.getElementById('feed-grid');
    const sentinel = document.getElementById('feed-sentinel');
    const dataEl = document.getElementById('feed-remaining');
    const remaining = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    let cursor = 0;

    const getTargetRowHeight = (containerWidth) => {
      let columns;
      if (containerWidth >= 1728) columns = 31;
      else if (containerWidth >= 1440) columns = 20;
      else if (containerWidth >= 1200) columns = 14;
      else if (containerWidth >= 768) columns = 9;
      else if (containerWidth >= 480) columns = 7;
      else columns = 5;

      const cellWidth = (containerWidth - gap * (columns - 1)) / columns;
      return cellWidth * (4 / 3);
    };

    const layout = () => {
      const cells = grid ? Array.from(grid.children) : [];
      if (!grid || cells.length === 0) return;

      const containerWidth = grid.clientWidth;
      if (containerWidth <= 0) return;

      const targetHeight = getTargetRowHeight(containerWidth);
      const maxHeight = targetHeight * 1.8;

      let row = [];
      let rowRatioSum = 0;

      const flushRow = (isTrailing) => {
        if (row.length === 0) return;

        const height = isTrailing
          ? targetHeight
          : Math.min((containerWidth - gap * (row.length - 1)) / rowRatioSum, maxHeight);

        let usedWidth = 0;

        row.forEach((cell, i) => {
          const ratio = parseFloat(cell.dataset.ratio) || 1;
          const isLastInRow = i === row.length - 1;
          const width =
            !isTrailing && isLastInRow ? containerWidth - usedWidth : Math.round(ratio * height);

          cell.style.width = `${width}px`;
          cell.style.height = `${height}px`;
          usedWidth += width + gap;
        });

        row = [];
        rowRatioSum = 0;
      };

      for (const cell of cells) {
        const ratio = parseFloat(cell.dataset.ratio) || 1;
        row.push(cell);
        rowRatioSum += ratio;

        const widthAtTarget = rowRatioSum * targetHeight + gap * (row.length - 1);
        if (widthAtTarget >= containerWidth) flushRow(false);
      }

      flushRow(true);
    };

    const addCell = (photo, index) => {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.dataset.ratio = String(photo.ratio);
      cell.style.aspectRatio = String(photo.ratio);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'photo-button';
      button.dataset.index = String(index);
      button.setAttribute('aria-label', 'View photo full screen');

      const img = document.createElement('img');
      img.className = 'photo';
      img.src = photo.src;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';

      button.appendChild(img);
      cell.appendChild(button);
      grid?.appendChild(cell);
    };

    const loadMore = () => {
      const next = remaining.slice(cursor, cursor + batchSize);

      if (next.length === 0) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        sentinel?.remove();
        return;
      }

      next.forEach((photo, i) => addCell(photo, initialCount + cursor + i));

      cursor += batchSize;
      layout();
    };

    let ticking = false;

    const checkScroll = () => {
      ticking = false;

      if (!sentinel) return;

      const nearViewport = sentinel.getBoundingClientRect().top < window.innerHeight + 600;

      if (nearViewport) loadMore();
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(checkScroll);
    };

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 150);
    });

    layout();

    if (sentinel && remaining.length > 0) {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      checkScroll();
    } else {
      sentinel?.remove();
    }

    const allPhotoSrcs = Array.from(grid?.querySelectorAll('.photo') ?? [])
      .map((img) => img.src)
      .concat(remaining.map((photo) => photo.src));

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    let currentIndex = -1;

    const show = (index) => {
      currentIndex = (index + allPhotoSrcs.length) % allPhotoSrcs.length;
      if (lightboxImg) lightboxImg.src = allPhotoSrcs[currentIndex];
    };

    const openLightbox = (index) => {
      show(index);
      if (lightbox) lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (lightbox) lightbox.hidden = true;
      document.body.style.overflow = '';
    };

    grid?.addEventListener('click', (event) => {
      const button = event.target.closest('.photo-button');
      if (!button) return;
      openLightbox(Number(button.dataset.index));
    });

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => show(currentIndex - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => show(currentIndex + 1));

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox || lightbox.hidden) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') show(currentIndex - 1);
      if (event.key === 'ArrowRight') show(currentIndex + 1);
    });
  </script>
</Layout>

<style is:global>
  .feed-wrap {
    max-width: 1800px;
    margin: 0 auto;
    padding: 20px;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .cell {
    width: 200px;
    overflow: hidden;
    background: #eee;
  }

  .photo-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 40px 20px;
  }

  #feed-sentinel {
    height: 1px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem 1rem;
  }

  .lightbox-close {
    top: 1rem;
    right: 1.5rem;
  }

  .lightbox-prev {
    left: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>
