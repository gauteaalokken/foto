---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { mapWithConcurrency } from '../lib/concurrency';
import { resolveImageWithAspectRatio, resolveOgImage, isRemote, withBase } from '../lib/resolveImage';

const raceGallery = await getEntry('fjellmaraton', 'index');
const racePhotos = raceGallery?.data.photos ?? [];
const topPhotos = raceGallery?.data.topPhotos ?? [];
// Oppføringer kan ligge klare i CMS-et uten fil ennå; de vises først når det
// faktisk finnes noe å laste ned, ellers ville en tom rad sett ødelagt ut.
const downloads = (raceGallery?.data.downloads ?? []).filter((item) => item.file);

// Adresseknappen slås av og på i CMS-et, og skjules uansett om lenka mangler.
const address = raceGallery?.data.address;
const showAddress = Boolean(address?.enabled && address?.url);

// Filnavn fra CMS-et kan inneholde mellomrom og norske tegn, som må kodes for
// å bli en gyldig lenke. Er adressen allerede kodet (inneholder %-sekvenser),
// lar vi den være — encodeURI ville da kodet selve prosenttegnet på nytt.
const safeUrl = (url: string) => (/%[0-9A-Fa-f]{2}/.test(url) ? url : encodeURI(url));

// Filtypen leses ut av fila, så merkelappen stemmer uansett hva som lastes opp.
const fileLabel = (url: string) => {
  const extension = url.split(/[?#]/)[0].split('.').pop() ?? '';
  return /^[a-z0-9]{1,5}$/i.test(extension) ? extension.toUpperCase() : 'FIL';
};

const GRID_WIDTH = 700;

// The top photos run the full width of the window, so on a wide screen each is
// rendered several times larger than a grid thumbnail — and twice that again in
// device pixels on a retina display. They're offered at several widths rather
// than one so the browser can pick: a phone, which only shows the banner a few
// hundred pixels tall, has no reason to pull down the 2400px version.
const TOP_WIDTHS = [900, 1600, 2400];
const TOP_QUALITY = 88;

const resolvePhoto = async (photo: string, width: number) => {
  const resolved = isRemote(photo)
    ? await resolveImageWithAspectRatio(photo, width, 82)
    : { src: withBase(photo), aspectRatio: 1 };

  return { src: resolved.src, ratio: resolved.aspectRatio, full: isRemote(photo) ? photo : withBase(photo) };
};

const resolveTopPhoto = async (photo: string) => {
  if (!isRemote(photo)) {
    return { src: withBase(photo), srcset: '', ratio: 1, full: withBase(photo) };
  }

  const rendered = await Promise.all(
    TOP_WIDTHS.map((width) => resolveImageWithAspectRatio(photo, width, TOP_QUALITY))
  );

  return {
    // Largest as the plain src, so a browser without srcset support still gets
    // a sharp image rather than the smallest one.
    src: rendered[rendered.length - 1].src,
    srcset: rendered.map((image, i) => `${image.src} ${TOP_WIDTHS[i]}w`).join(', '),
    ratio: rendered[0].aspectRatio,
    full: photo,
  };
};

// The lightbox links to the original R2 file for full quality — no extra resize needed.
const resolvedTopPhotos = await mapWithConcurrency(topPhotos, 2, resolveTopPhoto);
const resolvedRacePhotos = await mapWithConcurrency(racePhotos, 4, (photo) => resolvePhoto(photo, GRID_WIDTH));

// The first photo uploaded is the banner and sits in the middle, with the rest
// split evenly to either side of it. Two photos put the second one on the
// right; one photo is just the banner.
const [banner, ...flanking] = resolvedTopPhotos;
const leftOfBanner = flanking.slice(0, Math.floor(flanking.length / 2));
const rightOfBanner = flanking.slice(leftOfBanner.length);
const topRow = banner ? [...leftOfBanner, banner, ...rightOfBanner] : [];

// Each photo's width is its share of the combined aspect ratios, since the row
// is full-bleed and every photo ends up the same height. Telling the browser
// the real figure matters both ways: guess low and it picks a blurry file,
// guess high and it downloads a needlessly large one. It also adapts on its
// own when the page holds one, two or three photos.
const topRatioSum = topRow.reduce((sum, photo) => sum + photo.ratio, 0);
const widthShare = (photo: (typeof topRow)[number]) => Math.round((photo.ratio / topRatioSum) * 100);

// Banneret er bildet siden handler om, så det er det folk bør se når lenka
// deles. Originalen er 28 MB — langt over det de fleste tjenester gidder å
// laste ned — så vi lager en egen liten JPEG til formålet.
const shareSource = topPhotos[0] ?? racePhotos[0];
const shareImage = shareSource ? await resolveOgImage(shareSource) : undefined;
---

<Layout
  title="Flaksjøen Fjellmaraton — Gaute Aaløkken"
  description="Påmelding til Flaksjøen Fjellmaraton 26. Velg mellom korte runden (12k) og mellomrunden (21k), og meld deg på her."
  image={shareImage}
>
  {topRow.length > 0 && (
    <div class="top-wrap">
      <div class="top-photos">
        {topRow.map((photo) => (
          <button
            type="button"
            class:list={['photo-button', 'top-cell', photo === banner && 'top-banner']}
            style={`--ratio: ${photo.ratio}`}
            aria-label="Vis bilde i fullskjerm"
          >
            <img
              src={photo.src}
              srcset={photo.srcset || undefined}
              sizes={`(max-width: 900px) 90vw, ${widthShare(photo)}vw`}
              alt=""
              decoding="async"
            />
          </button>
        ))}
      </div>
    </div>
  )}

  <div class="intro">
    <h1>Flaksjøen Fjellmaraton</h1>
    <h2>Påmelding 26</h2>

    <button type="button" id="open-signup" class="signup-button">Meld deg på</button>

    {showAddress && (
      <a class="address-button" href={safeUrl(address!.url!)} target="_blank" rel="noopener">
        {address!.label || 'Adresse'}
      </a>
    )}

    {downloads.length > 0 && (
      <div class="routes">
        <h3>Nedlastinger</h3>
        <ul>
          {downloads.map((item) => (
            <li>
              {/* download gir fila et fornuftig navn når nettleseren laster den
                  ned. Attributtet ignoreres for filer fra et annet domene, som
                  R2 er — da avgjør nettleseren selv, og en .gpx lastes ned
                  framfor å vises. */}
              <a href={safeUrl(item.file)} download>
                {item.name}
                <span class="routes-format">{fileLabel(item.file)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div id="signup-modal" class="modal" hidden>
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="signup-heading">
      <button type="button" id="close-signup" class="modal-close" aria-label="Lukk">&times;</button>

      <h2 id="signup-heading">Påmelding 26</h2>

      <form id="paamelding-form">
      <div class="field-group">
        <span class="group-label">Navn</span>
        <div class="row">
          <label>
            Fornavn
            <input type="text" name="firstName" required />
          </label>
          <label>
            Etternavn
            <input type="text" name="lastName" required />
          </label>
        </div>
      </div>

      <label class="field">
        E-post
        <input type="email" name="email" required />
      </label>

      <label class="field">
        Telefon
        <input type="tel" name="phone" />
      </label>

      <label class="field">
        Hvilken runde ser du for deg å løpe neste år?
        <select name="runde" required>
          <option value="Korte runden 12k">Korte runden 12k</option>
          <option value="Mellomrunden 21k">Mellomrunden 21k</option>
        </select>
      </label>

      <label class="field">
        Hvordan tenker du å sove?
        <select name="overnatting">
          <option value="" selected disabled>Sengeplasser i hytta blir fordelt etter ansiennitet</option>
          <option value="Hytta">Hytta</option>
          <option value="Utenfor hytta">Utenfor hytta</option>
          <option value="Annen hytte e.l">Annen hytte e.l</option>
        </select>
      </label>

      <label class="field">
        Noe mer?
        <textarea name="message" rows="5"></textarea>
      </label>

      <div class="honeypot" aria-hidden="true">
        <label>
          La dette feltet stå tomt
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

        <button type="submit">Send</button>

        <p id="form-status" role="status"></p>
      </form>
    </div>
  </div>

  {resolvedRacePhotos.length > 0 && (
    <div class="grid-wrap">
      <div class="grid" id="race-grid">
        {resolvedRacePhotos.map((photo, index) => (
          <div class="cell" data-ratio={photo.ratio}>
            <button type="button" class="photo-button" data-index={index} aria-label="Vis bilde i fullskjerm">
              <img class="photo" src={photo.src} alt="" loading="lazy" decoding="async" />
            </button>
          </div>
        ))}
      </div>
    </div>
  )}

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Lukk">&times;</button>
    <button type="button" id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Forrige bilde">&#8249;</button>
    <img id="lightbox-img" class="lightbox-img" alt="" />
    <button type="button" id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Neste bilde">&#8250;</button>
  </div>

  {/* Top photos first: the lightbox pairs each .photo-button with this list by
      DOM order, and those buttons are rendered above the grid. */}
  <script
    type="application/json"
    id="race-photos"
    set:html={JSON.stringify([...topRow, ...resolvedRacePhotos].map((p) => p.full))}
  />
</Layout>

<script>
  const GAP = 10;

  const grid = document.getElementById('race-grid');

  // Row-justified layout, like the Feed page: pack photos into rows at their
  // real aspect ratio (no cropping), stretched to fill the row's width.
  const getColumnTarget = (containerWidth: number) => {
    if (containerWidth >= 1024) return 4;
    if (containerWidth >= 640) return 3;
    return 2;
  };

  const ratioOf = (cell: HTMLElement) => parseFloat(cell.dataset.ratio || '1') || 1;

  // See the project pages: clientWidth is rounded to whole pixels and can round
  // *up* — at a 1728px viewport the container is really 1169.59px but reports
  // 1170 — leaving rows a fraction wider than the container and making
  // flex-wrap push the last cell of every row onto its own line. Whether that
  // happens comes down to which way the fraction rounds, so it shows up at some
  // window widths and not others. Floor the true width so rows stay inside it.
  const measureWidth = () => Math.floor(grid!.getBoundingClientRect().width);

  const layout = () => {
    const cells = grid ? (Array.from(grid.children) as HTMLElement[]) : [];
    if (!grid || cells.length === 0) return;

    const containerWidth = measureWidth();
    if (containerWidth <= 0) return;

    const columns = getColumnTarget(containerWidth);
    const targetHeight = (containerWidth - GAP * (columns - 1)) / columns;
    const maxHeight = targetHeight * 1.6;

    const rows: HTMLElement[][] = [];
    let row: HTMLElement[] = [];
    let rowRatioSum = 0;

    for (const cell of cells) {
      row.push(cell);
      rowRatioSum += ratioOf(cell);

      const widthAtTarget = rowRatioSum * targetHeight + GAP * (row.length - 1);
      if (widthAtTarget >= containerWidth || row.length >= columns) {
        rows.push(row);
        row = [];
        rowRatioSum = 0;
      }
    }

    if (row.length) rows.push(row);

    // The height a row would need to span the full width at its photos' own
    // aspect ratios.
    const naturalHeight = (r: HTMLElement[]) =>
      (containerWidth - GAP * (r.length - 1)) / r.reduce((sum, cell) => sum + ratioOf(cell), 0);

    // A leftover final row of one or two photos can't span the width without
    // growing absurdly tall, so it gets capped — stranding it at a fraction of
    // the width with photos noticeably *larger* than the rows above. Folding it
    // into the previous row costs that row a little height and fills the width
    // instead. Repeat, since one fold can leave the merged row still too tall.
    while (rows.length > 1 && naturalHeight(rows[rows.length - 1]) > maxHeight) {
      const stranded = rows.pop() as HTMLElement[];
      rows[rows.length - 1].push(...stranded);
    }

    for (const currentRow of rows) {
      const natural = naturalHeight(currentRow);
      const height = Math.min(natural, maxHeight);
      // Only a single row of very few photos can still be capped here; the
      // parent's justify-content: center keeps it centred rather than ragged.
      const isCapped = height < natural;

      let usedWidth = 0;

      currentRow.forEach((cell, i) => {
        const isLastInRow = i === currentRow.length - 1;
        // The last cell absorbs the rounding remainder so the row lands exactly
        // on the container's right edge.
        const width =
          !isCapped && isLastInRow ? containerWidth - usedWidth : Math.round(ratioOf(cell) * height);

        cell.style.width = `${width}px`;
        cell.style.height = `${height}px`;
        usedWidth += width + GAP;
      });
    }
  };

  layout();

  // See the note on the project pages: layout() writes explicit pixel widths
  // onto every cell, so it has to re-run whenever the width it measured stops
  // being the real one — otherwise the rows stay ragged until the next reload.
  // Width changes cover resizing; the unconditional re-runs cover a first
  // measurement taken before stylesheets, fonts or images settled.
  let lastWidth = grid ? measureWidth() : 0;
  let layoutTimer: ReturnType<typeof setTimeout>;

  const scheduleLayout = () => {
    clearTimeout(layoutTimer);
    layoutTimer = setTimeout(() => {
      if (grid) lastWidth = measureWidth();
      layout();
    }, 120);
  };

  // Only width matters — layout() changes the grid's own height, and reacting
  // to that would loop.
  const relayoutIfWidthChanged = () => {
    if (!grid || measureWidth() === lastWidth) return;
    scheduleLayout();
  };

  if (grid) new ResizeObserver(relayoutIfWidthChanged).observe(grid);
  window.addEventListener('resize', relayoutIfWidthChanged);

  window.addEventListener('load', scheduleLayout);
  document.fonts?.ready.then(scheduleLayout);
  grid?.querySelectorAll('img').forEach((img) => {
    if (!(img as HTMLImageElement).complete) {
      img.addEventListener('load', scheduleLayout, { once: true });
    }
  });

  const dataEl = document.getElementById('race-photos');
  const fullPhotos: string[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo-button'));
  const lightbox = document.getElementById('lightbox') as HTMLDivElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  let currentIndex = -1;

  // Opening the lightbox meant a black screen while the original downloaded
  // straight from R2 — 15-20 MB for the biggest of them. The thumbnail on the
  // page is already in the browser's cache, so it goes up immediately and the
  // original takes its place the moment it arrives. The width is pinned to the
  // size the original will take (same photo, same proportions), so the swap
  // doesn't move anything on screen.
  let pendingOriginal = 0;

  const show = (index: number) => {
    currentIndex = (index + fullPhotos.length) % fullPhotos.length;
    if (!lightboxImg) return;

    const token = ++pendingOriginal;
    const thumb = buttons[currentIndex]?.querySelector('img');
    const ratio = thumb?.naturalWidth ? thumb.naturalWidth / thumb.naturalHeight : 0;

    lightboxImg.style.width = ratio ? `min(90vw, ${(90 * ratio).toFixed(2)}vh)` : '';
    lightboxImg.src = thumb?.currentSrc || fullPhotos[currentIndex];

    const original = new Image();
    original.addEventListener('load', () => {
      // A slow original the visitor has already paged past is dropped.
      if (token === pendingOriginal) lightboxImg.src = original.src;
    });
    original.src = fullPhotos[currentIndex];
  };

  const open = (index: number) => {
    show(index);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    lightbox.hidden = true;
    document.body.style.overflow = '';
  };

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => open(index));
  });

  document.getElementById('lightbox-close')?.addEventListener('click', close);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => show(currentIndex - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => show(currentIndex + 1));

  lightbox.addEventListener('click', (event) => {
    if (event.target === lightbox) close();
  });

  document.addEventListener('keydown', (event) => {
    if (lightbox.hidden) return;
    if (event.key === 'Escape') close();
    if (event.key === 'ArrowLeft') show(currentIndex - 1);
    if (event.key === 'ArrowRight') show(currentIndex + 1);
  });
</script>

<script>
  // Adressen til Google Apps Script-distribusjonen som tar imot påmeldingene.
  //
  // Skal du oppdatere skriptet: bruk ALLTID Implementer > Administrer
  // distribusjoner > blyantikon > Versjon "Ny versjon" > Implementer. Da
  // beholder distribusjonen denne adressen. Lager du en «Ny distribusjon» i
  // stedet, får den en annen adresse, og påmeldingene fortsetter å gå hit — til
  // den gamle koden — uten noen feilmelding.
  //
  // Full framgangsmåte: scripts/LES-MEG-paamelding.md
  // Koden som kjører der: scripts/google-apps-script-paamelding.gs
  const GAS_URL = 'https://script.google.com/macros/s/AKfycbwFp6qwhb72J4qkg3a82rSNTviuDEcRw6WcgE21cS-0y3Y-BGpBc3jYY35hiIMR8vV1/exec';

  const form = document.getElementById('paamelding-form') as HTMLFormElement;

  // The form lives in a dialog rather than on the page, opened by the button
  // between the banner and the grid below.
  const modal = document.getElementById('signup-modal') as HTMLDivElement;
  const openButton = document.getElementById('open-signup') as HTMLButtonElement;

  const openModal = () => {
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    // Focus the first field so keyboard and screen-reader users land inside the
    // dialog rather than back at the top of the page.
    (form.querySelector('input, select, textarea') as HTMLElement | null)?.focus();
  };

  const closeModal = () => {
    modal.hidden = true;
    document.body.style.overflow = '';
    openButton.focus();
  };

  openButton.addEventListener('click', openModal);
  document.getElementById('close-signup')?.addEventListener('click', closeModal);

  // Clicking the backdrop closes; clicking inside the panel must not.
  modal.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !modal.hidden) closeModal();
  });
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = Object.fromEntries(new FormData(form).entries());

    // Honeypot: the field is off-screen, so a real visitor never fills it and
    // anything in it means a bot. Show the normal success message rather than
    // an error, so a bot can't learn what tripped the rejection.
    if (data.website) {
      form.reset();
      status.textContent = 'Takk for din påmelding!';
      status.className = 'success';
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitButton.disabled = true;
    // Apps Script takes a few seconds to answer, and now that we wait for the
    // real response rather than firing and forgetting, that wait is visible —
    // so say something instead of leaving a dead button.
    status.textContent = 'Sender…';
    status.className = '';

    try {
      // text/plain keeps this a "simple" CORS request, so the browser skips the
      // preflight that Apps Script can't answer — while still letting us read
      // the response. mode: 'no-cors' would avoid the preflight too, but its
      // opaque response resolves even on a 500, reporting success to the
      // visitor while the sign-up was silently dropped.
      const res = await fetch(GAS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      // A crash inside the Apps Script returns an HTML error page instead of
      // JSON, so a parse failure here counts as a failed sign-up too.
      const result = await res.json();
      if (result.status !== 'ok') throw new Error(result.message || 'Ukjent feil');

      form.reset();
      status.textContent = 'Takk for din påmelding!';
      status.className = 'success';
    } catch (err) {
      status.textContent =
        'Noe gikk galt — påmeldingen ble ikke registrert. Prøv igjen, eller send en e-post.';
      status.className = 'error';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>

<style>
  .intro {
    max-width: 600px;
    margin: 60px auto 100px;
    padding: 0 20px;
  }

  .signup-button {
    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1rem;
    letter-spacing: 0.02em;
    background: var(--ink);
    color: var(--ink-inverse);
    border: 1.5px solid var(--ink);
    padding: 0.9rem 2.75rem;
    margin-top: 1.5rem;
    cursor: pointer;
  }

  .signup-button:hover {
    background: var(--surface-raised);
    color: var(--ink);
  }

  /* Sekundær i forhold til «Meld deg på»: samme form, men bare omriss, så den
     ikke konkurrerer med hovedhandlingen på siden. */
  .address-button {
    display: inline-block;
    /* Venstremargen skiller den fra «Meld deg på», som står rett før. */
    margin: 1rem 0 0 0.75rem;
    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1rem;
    letter-spacing: 0.02em;
    background: transparent;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    padding: 0.9rem 2.75rem;
    text-decoration: none;
  }

  .address-button:hover {
    background: var(--ink);
    color: var(--ink-inverse);
  }

  .routes {
    margin-top: 3rem;
  }

  .routes h3 {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-subtle);
    margin: 0 0 0.75rem;
  }

  .routes ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .routes li + li {
    border-top: 1px solid var(--line);
  }

  .routes a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.05rem;
  }

  .routes a:hover {
    opacity: 0.6;
  }

  .routes-format {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-subtle);
    border: 1px solid var(--line);
    padding: 0.2rem 0.5rem;
  }

  /* Dialog holding the sign-up form. */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    padding: 5vh 20px;
    z-index: 1100;
  }

  .modal[hidden] {
    display: none;
  }

  .modal-panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: var(--surface);
    padding: 2.5rem 2rem;
    /* Helvetica for the form itself, rather than the system stack the rest of
       the page inherits. The inputs already use `font: inherit`, so they pick
       this up too. */
    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
  }

  .modal-panel h2 {
    font-family: inherit;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 2rem;
  }

  .modal-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .modal-close:hover {
    opacity: 0.6;
  }

  /* Full-bleed, unlike the grid below: these run the whole width of the window
     with no padding, so they sit flush against both edges and the header. */
  .top-wrap {
    margin: 0;
    padding: 0;
  }

  /* No JS here, unlike the grid below: giving each photo a flex-grow equal to
     its aspect ratio makes the widths proportional to the ratios, which means
