<script>
  // Visningsvalget (Lightroom / Kvalitativ / Ingen). Bytter bare data-mode på .fl.
  // Valget huskes i nettleseren. Feiler lagringen (privat vindu), virker siden fortsatt.
  const wrap = document.querySelector('.fl');
  const knapper = document.querySelectorAll('.mode button');

  function velg(modus) {
    wrap.setAttribute('data-mode', modus);
    knapper.forEach((k) => {
      k.setAttribute('aria-pressed', k.getAttribute('data-m') === modus ? 'true' : 'false');
    });
    try { localStorage.setItem('filmlook-mode', modus); } catch (e) {}
  }

  let lagret = null;
  try { lagret = localStorage.getItem('filmlook-mode'); } catch (e) {}
  if (lagret === 'lr' || lagret === 'ql' || lagret === 'none') velg(lagret);

  knapper.forEach((k) => {
    k.addEventListener('click', () => velg(k.getAttribute('data-m')));
  });
</script>
