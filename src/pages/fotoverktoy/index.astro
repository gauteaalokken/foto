---
/*
  LANDINGSSIDEN FOR FOTOVERKTØYENE

  Vil du legge til et verktøy: lag en ny side i denne mappa (kopier gjerne
  grid.astro som mal) og legg den inn i lista under. Navnet du skriver her er
  det samme som skal stå som `tittel` i verktøyet selv — de sto tidligere med
  hvert sitt navn, så kortet sa «Rammer» mens siden det gikk til het
  «Instagram Maler».
*/
import Layout from '../../layouts/Layout.astro';

const verktoy = [
  {
    href: '/fotoverktoy/grid',
    navn: 'Fotogrid',
    beskrivelse: 'Flere bilder per side, satt opp som ark til utskrift.',
    ikon: 'rutenett',
  },
  {
    href: '/fotoverktoy/instagram',
    navn: 'Instagram-maler',
    beskrivelse: 'Sett opp innlegg og se hvordan de tar seg ut i profilrutenettet.',
    ikon: 'instagram',
  },
  {
    href: '/fotoverktoy/kalender',
    navn: 'Kalender',
    beskrivelse: 'Månedsark med bilder over og kalenderrutenett under.',
    ikon: 'kalender',
  },
];
---

<Layout
  title="Fotoverktøy — Gaute Aaløkken"
  description="Egne verktøy for å sette opp bilder til utskrift, Instagram og kalender."
>
  <div class="verktoy-landing">
    <header class="topp">
      <h1>Fotoverktøy</h1>
      <p>Små verktøy jeg har laget for mitt eget arbeid med bilder.</p>
    </header>

    <div class="kort-rad">
      {verktoy.map((v) => (
        <a class="kort" href={v.href}>
          <span class="kort-ikon" aria-hidden="true">
            {v.ikon === 'rutenett' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
              </svg>
            )}
            {v.ikon === 'instagram' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            )}
            {v.ikon === 'kalender' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            )}
          </span>
          <h2>{v.navn}</h2>
          <p>{v.beskrivelse}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .verktoy-landing {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 24px 100px;
  }

  .topp {
    text-align: center;
    margin-bottom: 64px;
  }

  .topp h1 {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .topp p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1rem;
  }

  .kort-rad {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .kort {
    display: block;
    padding: 36px 28px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .kort:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .kort {
      transition: none;
    }

    .kort:hover {
      transform: none;
    }
  }

  .kort-ikon {
    display: block;
    margin: 0 auto 20px;
    width: 40px;
    height: 40px;
    color: var(--ink);
  }

  .kort-ikon :global(svg) {
    width: 40px;
    height: 40px;
  }

  .kort h2 {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .kort p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
