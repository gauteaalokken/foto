---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { mapWithConcurrency } from '../lib/concurrency';
import { resolveImage, withBase } from '../lib/resolveImage';

const projectEntries = await getCollection('projects');

const leadingYear = (year: string) => parseInt(year.match(/\d+/)?.[0] ?? '0', 10);

projectEntries.sort((a, b) => {
  const byYear = leadingYear(b.data.year) - leadingYear(a.data.year);
  return byYear !== 0 ? byYear : a.data.title.localeCompare(b.data.title);
});

const COVER_WIDTH = 1100;

const projects = await mapWithConcurrency(projectEntries, 3, async (entry) => {
  const { title, year, pages } = entry.data;
  const cover = pages[0] ? await resolveImage(pages[0], COVER_WIDTH, 80) : '';

  return { slug: entry.id, title, year, cover };
});
---

<Layout>
  <div class="projects-grid">
    {projects.map((project) => (
      <a class="project-card" href={withBase(`/prosjekter/${project.slug}`)}>
        <div class="cover-wrap">
          {project.cover && <img class="cover" src={project.cover} alt={project.title} loading="lazy" />}
        </div>
        <div class="caption">
          <span class="year">{project.year}</span>
          <span class="title">{project.title}</span>
        </div>
      </a>
    ))}
  </div>

  {projects.length === 0 && <p class="empty">Ingen prosjekter ennå.</p>}
</Layout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px 32px;
    max-width: 1800px;
    margin: 0 auto;
    padding: 40px 32px 80px;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 64px 40px;
    }
  }

  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .cover-wrap {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #eee;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .cover {
    transform: scale(1.02);
  }

  .caption {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .year {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: #888;
  }

  .title {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    font-weight: 400;
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
