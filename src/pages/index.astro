---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { mapWithConcurrency } from '../lib/concurrency';
import { resolveImageWithAspectRatio, withBase } from '../lib/resolveImage';

const projectEntries = await getCollection('projects');

const leadingYear = (year: string) => parseInt(year.match(/\d+/)?.[0] ?? '0', 10);

// Projects with an explicit "order" set always come first, lowest number
// shown first — full manual override for anyone who wants it. Everything
// else falls back to newest-year-first, so unordered projects still make
// sense without any manual upkeep.
projectEntries.sort((a, b) => {
  const orderA = a.data.order ?? Infinity;
  const orderB = b.data.order ?? Infinity;

  if (orderA !== orderB) return orderA - orderB;

  const byYear = leadingYear(b.data.year) - leadingYear(a.data.year);
  return byYear !== 0 ? byYear : a.data.title.localeCompare(b.data.title);
});

const COVER_WIDTH = 700;

const projects = await mapWithConcurrency(projectEntries, 3, async (entry) => {
  const { title, year, pages } = entry.data;
  const cover = pages[0] ? await resolveImageWithAspectRatio(pages[0], COVER_WIDTH, 80) : null;

  return { slug: entry.id, title, year, cover };
});

// Empty squares scattered randomly through the grid — the row is 4 slots
// wide, but only about 2-3 of those 4 are ever real photos, so it reads as
// a curated pick from a bigger archive rather than "this is literally
// everything". Recomputed on every build — the exact spots aren't meant to
// be stable.
type DisplayItem = { type: 'project'; project: (typeof projects)[number] } | { type: 'empty' };

// Never at position 0 — an empty tile with nothing above or beside it (e.g.
// alone at the top of a single-column mobile layout) reads as broken rather
// than curated, since there's no neighboring real photo for context.
const emptyCount = Math.max(1, Math.round(projects.length * 0.6));
const emptyPositions = new Set<number>();
while (emptyPositions.size < emptyCount && projects.length > 0) {
  emptyPositions.add(1 + Math.floor(Math.random() * projects.length));
}

const displayItems: DisplayItem[] = [];
projects.forEach((project, index) => {
  if (emptyPositions.has(index)) displayItems.push({ type: 'empty' });
  displayItems.push({ type: 'project', project });
});
if (emptyPositions.has(projects.length)) displayItems.push({ type: 'empty' });
---

<Layout>
  <div class="projects-grid">
    {displayItems.map((item) =>
      item.type === 'empty' ? (
        <div class="empty-cell" aria-hidden="true" />
      ) : (
        <a class="project-card" href={withBase(`/prosjekter/${item.project.slug}`)}>
          <div class="cover-wrap">
            {item.project.cover && (
              <img
                class="cover"
                src={item.project.cover.src}
                style={`aspect-ratio: ${item.project.cover.aspectRatio}`}
                alt={item.project.title}
                loading="lazy"
              />
            )}
          </div>
          <div class="caption">
            <span class="year">({item.project.year})</span>
            <span class="title">{item.project.title}</span>
          </div>
        </a>
      )
    )}
  </div>

  {projects.length === 0 && <p class="empty-state">Ingen prosjekter ennå.</p>}
</Layout>

<script>
  // The server-rendered empty cells give every visitor a valid layout even
  // without JS, but re-rolling them here means the arrangement is different
  // on every page load instead of only changing when the site rebuilds.
  const grid = document.querySelector<HTMLDivElement>('.projects-grid');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.project-card'));

    grid.querySelectorAll('.empty-cell').forEach((el) => el.remove());

    const emptyCount = Math.max(1, Math.round(cards.length * 0.6));
    const positions = new Set<number>();

    while (positions.size < emptyCount && cards.length > 0) {
      positions.add(1 + Math.floor(Math.random() * cards.length));
    }

    const makeEmptyCell = () => {
      const el = document.createElement('div');
      el.className = 'empty-cell';
      el.setAttribute('aria-hidden', 'true');
      return el;
    };

    cards.forEach((card, index) => {
      if (positions.has(index)) grid.insertBefore(makeEmptyCell(), card);
    });

    if (positions.has(cards.length)) grid.appendChild(makeEmptyCell());
  }
</script>

<style is:global>
  .projects-grid {
    display: grid;
    /* A fixed 4-column template rather than however-many-fit — since only
       about 2-3 of every 4 slots end up holding a real photo, columns stay
       the same width whether a row has 2, 3, or 4 filled. */
    grid-template-columns: repeat(2, 1fr);
    align-items: end;
    gap: 40px 32px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 40px 32px 80px;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 48px 40px;
    }
  }

  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .cover-wrap {
    overflow: hidden;
    background: #eee;
  }

  .cover {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .cover {
    transform: scale(1.02);
  }

  .empty-cell {
    aspect-ratio: 1 / 1;
  }

  .caption {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .year {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
  }

  .title {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .empty-state {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
