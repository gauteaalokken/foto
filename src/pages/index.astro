---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

const gallery = await getEntry('gallery', 'index');
const photos = gallery?.data.photos ?? [];

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const isRemote = (path: string) => /^https?:\/\//.test(path);
---

<Layout>
  <div class="masonry">
    {photos.map((photo) =>
      isRemote(photo) ? (
        <Image
          class="photo"
          src={photo}
          inferSize
          width={1400}
          quality={82}
          format="webp"
          alt=""
          loading="lazy"
        />
      ) : (
        <img class="photo" src={withBase(photo)} alt="" loading="lazy" />
      )
    )}
  </div>
</Layout>

<style>
  .masonry {
    column-count: 1;
    column-gap: 16px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
  }

  @media (min-width: 640px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry {
      column-count: 3;
    }
  }

  .photo {
    width: 100%;
    display: block;
    margin-bottom: 16px;
    border-radius: 4px;
    break-inside: avoid;
  }
</style>
