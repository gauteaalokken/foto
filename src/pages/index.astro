---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { mapWithConcurrency } from '../lib/concurrency';
import { isRemote, resolveImage, resolveImageSrcSet, withBase } from '../lib/resolveImage';
import GridHomepage from '../components/homepage/GridHomepage.astro';
import FullscreenScrollHomepage from '../components/homepage/FullscreenScrollHomepage.astro';
import PortfolioGridHomepage from '../components/homepage/PortfolioGridHomepage.astro';

const settings = await getEntry('homepageSettings', 'index');
const layout = settings?.data.layout ?? 'grid';

// Only the active layout's data is fetched/processed — switching layouts in
// the CMS doesn't pay for the resolution or collection the others don't use.
let projects: Awaited<ReturnType<typeof loadProjects>> = [];
let portfolioPhotos: Awaited<ReturnType<typeof loadPortfolio>> = [];

async function loadProjects(coverWidths: number[], coverQuality: number) {
  const projectEntries = await getCollection('projects');
  const leadingYear = (year: string) => parseInt(year.match(/\d+/)?.[0] ?? '0', 10);

  // Projects with an explicit "order" set always come first, lowest number
  // shown first — full manual override for anyone who wants it. Everything
  // else falls back to newest-year-first, so unordered projects still make
  // sense without any manual upkeep.
  projectEntries.sort((a, b) => {
    const orderA = a.data.order ?? Infinity;
    const orderB = b.data.order ?? Infinity;

    if (orderA !== orderB) return orderA - orderB;

    const byYear = leadingYear(b.data.year) - leadingYear(a.data.year);
    return byYear !== 0 ? byYear : a.data.title.localeCompare(b.data.title);
  });

  return mapWithConcurrency(projectEntries, 3, async (entry) => {
    const { title, year, pages } = entry.data;
    const coverSrc = entry.data.cover || pages[0];
    const cover = coverSrc ? await resolveImageSrcSet(coverSrc, coverWidths, coverQuality) : null;

    return { slug: entry.id, title, year, cover };
  });
}

async function loadPortfolio() {
  const entry = await getEntry('portfolio', 'index');
  const photos = entry?.data.photos ?? [];

  return mapWithConcurrency(photos, 4, async (photo) => ({
    src: await resolveImage(photo, 1400, 82),
    full: isRemote(photo) ? photo : withBase(photo),
  }));
}

if (layout === 'portfolioGrid') {
  portfolioPhotos = await loadPortfolio();
} else {
  // Several widths per cover so phones don't download a desktop-sized file
  // (the fullscreen covers reach 2.7 MB) — the browser picks from the srcset.
  // The fullscreen variant shows covers at up to full viewport width/height,
  // so its ladder tops out much higher than the grid's card-sized thumbnails.
  const [coverWidths, coverQuality] = layout === 'fullscreenScroll'
    ? [[800, 1400, 2000], 90]
    : [[500, 900], 85];
  projects = await loadProjects(coverWidths, coverQuality);
}
---

<Layout bodyClass={layout === 'fullscreenScroll' ? 'scroll-homepage-active' : undefined}>
  {layout === 'fullscreenScroll' ? (
    <FullscreenScrollHomepage projects={projects} />
  ) : layout === 'portfolioGrid' ? (
    <PortfolioGridHomepage photos={portfolioPhotos} />
  ) : (
    <GridHomepage projects={projects} tight={layout === 'gridTight'} />
  )}
</Layout>
