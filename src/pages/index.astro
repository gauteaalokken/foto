---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { mapWithConcurrency } from '../lib/concurrency';
import { resolveImageWithAspectRatio, withBase } from '../lib/resolveImage';

const projectEntries = await getCollection('projects');

const leadingYear = (year: string) => parseInt(year.match(/\d+/)?.[0] ?? '0', 10);

projectEntries.sort((a, b) => {
  const byYear = leadingYear(b.data.year) - leadingYear(a.data.year);
  return byYear !== 0 ? byYear : a.data.title.localeCompare(b.data.title);
});

const COVER_WIDTH = 700;

const projects = await mapWithConcurrency(projectEntries, 3, async (entry) => {
  const { title, year, pages } = entry.data;
  const cover = pages[0] ? await resolveImageWithAspectRatio(pages[0], COVER_WIDTH, 80) : null;

  return { slug: entry.id, title, year, cover };
});

// A few empty squares scattered randomly through the grid, so it reads as a
// curated pick from a bigger archive rather than "this is literally everything".
// Recomputed on every build — the exact spots aren't meant to be stable.
type DisplayItem = { type: 'project'; project: (typeof projects)[number] } | { type: 'empty' };

const emptyCount = Math.max(1, Math.round(projects.length / 3));
const emptyPositions = new Set<number>();
while (emptyPositions.size < emptyCount && projects.length > 0) {
  emptyPositions.add(Math.floor(Math.random() * (projects.length + 1)));
}

const displayItems: DisplayItem[] = [];
projects.forEach((project, index) => {
  if (emptyPositions.has(index)) displayItems.push({ type: 'empty' });
  displayItems.push({ type: 'project', project });
});
if (emptyPositions.has(projects.length)) displayItems.push({ type: 'empty' });
---

<Layout>
  <div class="projects-grid">
    {displayItems.map((item) =>
      item.type === 'empty' ? (
        <div class="empty-cell" aria-hidden="true" />
      ) : (
        <a class="project-card" href={withBase(`/prosjekter/${item.project.slug}`)}>
          <div class="cover-wrap">
            {item.project.cover && (
              <img
                class="cover"
                src={item.project.cover.src}
                style={`aspect-ratio: ${item.project.cover.aspectRatio}`}
                alt={item.project.title}
                loading="lazy"
              />
            )}
          </div>
          <div class="caption">
            <span class="year">({item.project.year})</span>
            <span class="title">{item.project.title}</span>
          </div>
        </a>
      )
    )}
  </div>

  {projects.length === 0 && <p class="empty-state">Ingen prosjekter ennå.</p>}
</Layout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: 40px 32px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px 80px;
  }

  @media (min-width: 480px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px 40px;
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 56px 48px;
    }
  }

  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .cover-wrap {
    overflow: hidden;
    background: #eee;
  }

  .cover {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .cover {
    transform: scale(1.02);
  }

  .empty-cell {
    aspect-ratio: 1 / 1;
  }

  .caption {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .year {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
  }

  .title {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .empty-state {
    text-align: center;
    color: #666;
    padding: 80px 20px;
  }
</style>
