---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const gallery = await getEntry('gallery', 'index');
const photos = gallery?.data.photos ?? [];

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<Layout>
  <div class="gallery">
    {photos.map((photo) => (
      <div class="photo-card">
        <img src={withBase(photo)} alt="" loading="lazy" />
      </div>
    ))}
  </div>
</Layout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }

  .photo-card {
    background: white;
    padding: 15px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }

  img {
    max-width: 100%;
    display: block;
    border-radius: 4px;
  }
</style>
