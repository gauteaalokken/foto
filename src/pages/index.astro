---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { mapWithConcurrency } from '../lib/concurrency';
import { resolveImageWithAspectRatio } from '../lib/resolveImage';
import GridHomepage from '../components/homepage/GridHomepage.astro';
import FullscreenScrollHomepage from '../components/homepage/FullscreenScrollHomepage.astro';

const projectEntries = await getCollection('projects');

const leadingYear = (year: string) => parseInt(year.match(/\d+/)?.[0] ?? '0', 10);

// Projects with an explicit "order" set always come first, lowest number
// shown first — full manual override for anyone who wants it. Everything
// else falls back to newest-year-first, so unordered projects still make
// sense without any manual upkeep.
projectEntries.sort((a, b) => {
  const orderA = a.data.order ?? Infinity;
  const orderB = b.data.order ?? Infinity;

  if (orderA !== orderB) return orderA - orderB;

  const byYear = leadingYear(b.data.year) - leadingYear(a.data.year);
  return byYear !== 0 ? byYear : a.data.title.localeCompare(b.data.title);
});

const COVER_WIDTH = 700;

const projects = await mapWithConcurrency(projectEntries, 3, async (entry) => {
  const { title, year, pages } = entry.data;
  const coverSrc = entry.data.cover || pages[0];
  const cover = coverSrc ? await resolveImageWithAspectRatio(coverSrc, COVER_WIDTH, 80) : null;

  return { slug: entry.id, title, year, cover };
});

const settings = await getEntry('homepageSettings', 'index');
const layout = settings?.data.layout ?? 'grid';
---

<Layout bodyClass={layout === 'fullscreenScroll' ? 'scroll-homepage-active' : undefined}>
  {layout === 'fullscreenScroll' ? (
    <FullscreenScrollHomepage projects={projects} />
  ) : (
    <GridHomepage projects={projects} tight={layout === 'gridTight'} />
  )}
</Layout>
