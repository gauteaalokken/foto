---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { mapWithConcurrency } from '../../lib/concurrency';
import { resolveImage } from '../../lib/resolveImage';

const entries = await getCollection('prints');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const PHOTO_WIDTH = 900;

const prints = await mapWithConcurrency(entries, 4, async (entry) => {
  const { title, photo } = entry.data;
  return { slug: entry.id, title, src: await resolveImage(photo, PHOTO_WIDTH, 85) };
});
---

<Layout
  title="Prints — Gaute Aaløkken"
  description="Fine-art prints til salgs, i A2, A3 og A4 — med eller uten ramme i eik og glass."
>
  <div class="grid">
    {prints.map((print) => (
      <a class="print-card" href={withBase(`prints/${print.slug}`)}>
        <img class="photo" src={print.src} alt={print.title} loading="lazy" />
        <span class="title">{print.title}</span>
      </a>
    ))}
  </div>

  {prints.length === 0 && <p class="empty">No prints listed yet.</p>}
</Layout>

<style>
  .grid {
    column-count: 1;
    column-gap: 24px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  @media (min-width: 768px) {
    .grid {
      column-count: 2;
    }
  }

  @media (min-width: 1400px) {
    .grid {
      column-count: 3;
    }
  }

  .print-card {
    display: block;
    width: 100%;
    margin-bottom: 24px;
    break-inside: avoid;
    text-decoration: none;
    color: inherit;
    background: #f2f2f2;
    padding: 40px;
    box-sizing: border-box;
  }

  .photo {
    width: 100%;
    display: block;
  }

  .title {
    display: block;
    margin-top: 16px;
    text-align: center;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .print-card:hover .title,
  .print-card:focus-visible .title {
    opacity: 1;
  }

  /* Touch devices have no hover, so the title would otherwise never show. */
  @media (hover: none) {
    .title {
      opacity: 1;
    }
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 40px 20px;
  }
</style>
