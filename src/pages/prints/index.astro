---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { mapWithConcurrency } from '../../lib/concurrency';
import { resolveImageWithAspectRatio } from '../../lib/resolveImage';

const entries = await getCollection('prints');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const PHOTO_WIDTH = 900;

// Størrelsene står i printSettings, samme kilde som pristabellen på hver
// printside — slik at en ny størrelse ikke etterlater denne teksten utdatert.
const settings = await getEntry('printSettings', 'index');
const sizeNames = (settings?.data.sizes ?? []).map((size) => size.name).join(', ');

// Proporsjonene hentes ut her, ikke bare filnavnet: uten dem har kortene
// ingen høyde før bildet er lastet, så rutenettet legger seg først som en
// stripe av titler og hopper deretter på plass etter hvert som bildene kommer.
const prints = await mapWithConcurrency(entries, 4, async (entry) => {
  const { title, photo } = entry.data;
  const resolved = await resolveImageWithAspectRatio(photo, PHOTO_WIDTH, 85);
  return { slug: entry.id, title, src: resolved.src, aspectRatio: resolved.aspectRatio };
});
---

<Layout
  title="Prints — Gaute Aaløkken"
  description={`Fine-art prints til salgs${sizeNames ? `, i ${sizeNames}` : ''} — med eller uten ramme i eik og glass.`}
>
  <div class="grid">
    {prints.map((print) => (
      <a class="print-card" href={withBase(`prints/${print.slug}`)}>
        <img
          class="photo"
          src={print.src}
          style={`aspect-ratio: ${print.aspectRatio}`}
          alt={print.title}
          loading="lazy"
        />
        <span class="title">{print.title}</span>
      </a>
    ))}
  </div>

  {prints.length === 0 && <p class="empty">Ingen prints lagt ut ennå.</p>}
</Layout>

<style>
  .grid {
    column-count: 1;
    column-gap: 24px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  @media (min-width: 768px) {
    .grid {
      column-count: 2;
    }
  }

  @media (min-width: 1400px) {
    .grid {
      column-count: 3;
    }
  }

  /* Ingen padding rundt bildet. Mockupene har allerede et jevnt lyst felt
     innebygd, så 40px kort-padding utenpå ga boks-i-boks — og spiste bredde
     der det gjorde mest vondt: på en 375px-skjerm ble kortet 335px, bildet
     255px, og selve fotografiet inni rammen rundt 130px. Bakgrunnen står
     igjen (samme verdi som mockupenes eget felt) slik at en framtidig mockup
     uten innebygd felt fortsatt får et kort å ligge på. */
  .print-card {
    display: block;
    width: 100%;
    margin-bottom: 24px;
    break-inside: avoid;
    text-decoration: none;
    color: inherit;
    background: var(--surface-sunken);
  }

  .photo {
    width: 100%;
    display: block;
  }

  /* Shown outright rather than on hover. This is the one page on the site
     that sells something, and a visitor scanning it shouldn't have to point
     at each frame to find out what it's called — the titles are how a print
     gets asked for by name in an email. Phones never had the hover state to
     begin with, so this also makes both views the same page. */
  .title {
    display: block;
    padding: 16px 20px 20px;
    text-align: center;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .print-card:hover .title,
  .print-card:focus-visible .title {
    color: var(--ink);
  }

  .empty {
    text-align: center;
    color: var(--ink-muted);
    padding: 40px 20px;
  }
</style>
