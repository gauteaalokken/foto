---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { mapWithConcurrency } from '../../lib/concurrency';
import { resolveImageWithAspectRatio, isRemote, withBase } from '../../lib/resolveImage';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, year, pages } = entry.data;

const GRID_WIDTH = 700;

// The lightbox links to the original R2 file for full quality — no extra resize needed.
const photos = await mapWithConcurrency(pages, 4, async (page) => {
  const resolved = isRemote(page)
    ? await resolveImageWithAspectRatio(page, GRID_WIDTH, 82)
    : { src: withBase(page), aspectRatio: 1 };

  return { src: resolved.src, ratio: resolved.aspectRatio, full: isRemote(page) ? page : withBase(page) };
});
---

<Layout
  title={`${title} — Gaute Aaløkken`}
  description={`${title} (${year}) — fotoprosjekt av Gaute Aaløkken.`}
  image={photos[0]?.full}
>
  <div class="project-page">
    <a href={withBase('/')} class="back-link">&larr; Tilbake</a>

    <header class="project-header">
      <h1>{title}</h1>
      <span class="project-year">({year})</span>
    </header>

    <div class="grid" id="project-grid">
      {photos.map((photo, index) => (
        <div class="cell" data-ratio={photo.ratio}>
          <button type="button" class="photo-button" data-index={index} aria-label="Vis bilde i fullskjerm">
            <img class="photo" src={photo.src} alt="" loading="lazy" decoding="async" />
          </button>
        </div>
      ))}
    </div>

    {photos.length === 0 && <p class="empty">Ingen bilder i dette prosjektet ennå.</p>}
  </div>

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Lukk">&times;</button>
    <button type="button" id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Forrige bilde">&#8249;</button>
    <img id="lightbox-img" class="lightbox-img" alt="" />
    <button type="button" id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Neste bilde">&#8250;</button>
  </div>

  <script type="application/json" id="project-photos" set:html={JSON.stringify(photos.map((p) => p.full))} />
</Layout>

<script>
  const GAP = 10;

  const grid = document.getElementById('project-grid');

  // Row-justified layout, like the Feed page: pack photos into rows at their
  // real aspect ratio (no cropping), stretched to fill the row's width — but
  // with a much lower column target, meant to read as "walk through the
  // project A to B" rather than a dense photo wall.
  const getColumnTarget = (containerWidth: number) => {
    if (containerWidth >= 1024) return 4;
    if (containerWidth >= 640) return 3;
    return 2;
  };

  const ratioOf = (cell: HTMLElement) => parseFloat(cell.dataset.ratio || '1') || 1;

  // clientWidth is rounded to whole pixels, and it can round *up*: at a 1728px
  // viewport the container is 70% wide minus padding = 1169.59px, which
  // clientWidth reports as 1170. Rows built to fill 1170 are then a fraction
  // wider than the container really is, so flex-wrap pushes the last cell of
  // every row onto its own line and the whole grid goes ragged.
  //
  // Whether that happens depends purely on which way the fraction rounds, which
  // is why it struck some window widths and not others — a maximised window
  // pins the viewport to the screen's exact width, so it reproduced reliably
  // there while an arbitrary dragged-out window usually rounded down and looked
  // fine. Flooring the true fractional width keeps rows just inside it.
  const measureWidth = () => Math.floor(grid!.getBoundingClientRect().width);

  const layout = () => {
    const cells = grid ? (Array.from(grid.children) as HTMLElement[]) : [];
    if (!grid || cells.length === 0) return;

    const containerWidth = measureWidth();
    if (containerWidth <= 0) return;

    const columns = getColumnTarget(containerWidth);
    const targetHeight = (containerWidth - GAP * (columns - 1)) / columns;
    const maxHeight = targetHeight * 1.6;

    const rows: HTMLElement[][] = [];
    let row: HTMLElement[] = [];
    let rowRatioSum = 0;

    for (const cell of cells) {
      row.push(cell);
      rowRatioSum += ratioOf(cell);

      const widthAtTarget = rowRatioSum * targetHeight + GAP * (row.length - 1);
      if (widthAtTarget >= containerWidth || row.length >= columns) {
        rows.push(row);
        row = [];
        rowRatioSum = 0;
      }
    }

    if (row.length) rows.push(row);

    // The height a row would need to span the full width at its photos' own
    // aspect ratios.
    const naturalHeight = (r: HTMLElement[]) =>
      (containerWidth - GAP * (r.length - 1)) / r.reduce((sum, cell) => sum + ratioOf(cell), 0);

    // A leftover final row of one or two photos can't span the width without
    // growing absurdly tall, so it gets capped — stranding it at a fraction of
    // the width with photos noticeably *larger* than the rows above. Folding it
    // into the previous row costs that row a little height and fills the width
    // instead. Repeat, since one fold can leave the merged row still too tall.
    while (rows.length > 1 && naturalHeight(rows[rows.length - 1]) > maxHeight) {
      const stranded = rows.pop() as HTMLElement[];
      rows[rows.length - 1].push(...stranded);
    }

    for (const currentRow of rows) {
      const natural = naturalHeight(currentRow);
      const height = Math.min(natural, maxHeight);
      // Only a single row of very few photos can still be capped here; the
      // parent's justify-content: center keeps it centred rather than ragged.
      const isCapped = height < natural;

      let usedWidth = 0;

      currentRow.forEach((cell, i) => {
        const isLastInRow = i === currentRow.length - 1;
        // The last cell absorbs the rounding remainder so the row lands exactly
        // on the container's right edge.
        const width =
          !isCapped && isLastInRow ? containerWidth - usedWidth : Math.round(ratioOf(cell) * height);

        cell.style.width = `${width}px`;
        cell.style.height = `${height}px`;
        usedWidth += width + GAP;
      });
    }
  };

  layout();

  // layout() writes explicit pixel widths onto every cell, so it has to re-run
  // whenever the width it measured stops being the real one. Miss that and the
  // cells keep their old sizes while flex-wrap repacks them into ragged,
  // differently wide rows — including a first row visibly narrower than the
  // ones below it, from a run that measured the container before it settled.
  //
  // The feed page never showed any of this despite sharing the layout code,
  // because each lazily-loaded photo re-runs its layout and quietly repairs a
  // bad first measurement. These pages had a single trigger, so one early or
  // missed measurement stuck until the next reload. Hence the same belt and
  // braces here: re-run on width changes, and again at each point that can
  // shift the container after first paint.
  let lastWidth = grid ? measureWidth() : 0;
  let layoutTimer: ReturnType<typeof setTimeout>;

  const scheduleLayout = () => {
    clearTimeout(layoutTimer);
    layoutTimer = setTimeout(() => {
      if (grid) lastWidth = measureWidth();
      layout();
    }, 120);
  };

  // ResizeObserver reports width changes whatever the cause, including ones a
  // resize event misses (zoom, a scrollbar appearing, the window resized while
  // this tab is hidden). Only width matters — layout() changes the grid's own
  // height, and reacting to that would loop.
  const relayoutIfWidthChanged = () => {
    if (!grid || measureWidth() === lastWidth) return;
    scheduleLayout();
  };

  if (grid) new ResizeObserver(relayoutIfWidthChanged).observe(grid);
  window.addEventListener('resize', relayoutIfWidthChanged);

  // Unconditional re-runs: stylesheets, fonts and late-arriving images can all
  // settle the container's width after the first layout() call, without
  // necessarily producing a width change this script observed in time.
  window.addEventListener('load', scheduleLayout);
  document.fonts?.ready.then(scheduleLayout);
  grid?.querySelectorAll('img').forEach((img) => {
    if (!(img as HTMLImageElement).complete) {
      img.addEventListener('load', scheduleLayout, { once: true });
    }
  });

  const dataEl = document.getElementById('project-photos');
  const fullPhotos: string[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo-button'));
  const lightbox = document.getElementById('lightbox') as HTMLDivElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  let currentIndex = -1;

  const show = (index: number) => {
    currentIndex = (index + fullPhotos.length) % fullPhotos.length;
    lightboxImg.src = fullPhotos[currentIndex];
  };

  const open = (index: number) => {
    show(index);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    lightbox.hidden = true;
    document.body.style.overflow = '';
  };

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => open(index));
  });

  document.getElementById('lightbox-close')?.addEventListener('click', close);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => show(currentIndex - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => show(currentIndex + 1));

  lightbox.addEventListener('click', (event) => {
    if (event.target === lightbox) close();
  });

  document.addEventListener('keydown', (event) => {
    if (lightbox.hidden) return;
    if (event.key === 'Escape') close();
    if (event.key === 'ArrowLeft') show(currentIndex - 1);
    if (event.key === 'ArrowRight') show(currentIndex + 1);
  });
</script>

<style>
  /* 70% of the window, but never narrower than 680px — below roughly a
     970px window that floor takes over, and once the window itself is
     narrower than the floor the page simply fills it.

     The floor replaces a `max-width: 100%` breakpoint at 900px, which made
     the width jump discontinuously: at a 900px window the grid ran the full
     width with no side margins at all, then widening to 920px shrank it to
     601px. Expressing it as one max() keeps the width continuous, so it only
     ever grows as the window grows. */
  .project-page {
    max-width: max(70%, 680px);
    margin: 0 auto;
    padding: 20px 20px 60px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: #111;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    opacity: 0.6;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .project-header h1 {
    font-family: 'Space Mono', monospace;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 500;
    margin: 0;
  }

  .project-year {
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    color: #888;
  }

  .empty {
    text-align: center;
    color: #666;
    padding: 40px 20px;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .cell {
    width: 300px;
    aspect-ratio: 1;
    overflow: hidden;
    background: #eee;
  }

  .photo-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem 1rem;
  }

  .lightbox-close {
    top: 1rem;
    right: 1.5rem;
  }

  .lightbox-prev {
    left: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>
